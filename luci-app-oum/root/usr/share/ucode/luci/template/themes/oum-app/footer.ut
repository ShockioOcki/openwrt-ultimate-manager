		{% if (!blank_page): %}
				</main>
				<footer class="oum-system-footer"><span>OUM · {{ version.distname }} {{ version.distversion }}</span><span>LuCI {{ version.luciversion }}</span></footer>
			</div>
		</div>
<style>.oum-bottom-nav{position:fixed!important;bottom:0!important;left:0!important;right:0!important;height:56px!important;background:var(--oum-paper,#fff)!important;border-top:1px solid var(--oum-line,#e5e7eb)!important;display:flex!important;z-index:40!important;padding:4px 0!important;color:var(--oum-ink,#0f172a)!important}.oum-bottom-nav button{flex:1!important;background:none!important;border:none!important;font-size:10px!important;font-weight:600!important;color:var(--oum-subtle,#6b7280)!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:2px!important;line-height:1!important}.oum-bottom-nav button.active{color:var(--oum-action,#2563eb)!important;font-weight:600!important}.oum-bottom-nav button svg{width:18px;height:18px}.oum-main{padding-bottom:64px!important}</style>
		<script>
		(function() {
			var root = document.documentElement;
			var toggle = document.getElementById('oum-theme-toggle');
			var menuToggle = document.getElementById('oum-menu-toggle');
			var sidebar = document.getElementById('oum-system-sidebar');
			var overlay = document.getElementById('oum-menu-overlay');
			var legacyObserver;
			function isOumPage() {
				var page = document.body.getAttribute('data-page') || '';
				return page === 'oum' || page.indexOf('oum-') === 0 || /\/cgi-bin\/luci\/oum(?:\/|$)/.test(location.pathname);
			}
			function ensureMobileBottomNav() {
				var existing = document.querySelector('.oum-bottom-nav');
				if (document.body.dataset.page === 'oum-setup') { if (existing) existing.remove(); return; }
				var oumPage = isOumPage();
				var luciPage = !oumPage && (/\/cgi-bin\/luci\/admin(?:\/|$)/.test(location.pathname) || /^\/cgi-bin\/luci\/?$/.test(location.pathname));
				if ((!oumPage && !luciPage) || window.innerWidth > 900) {
					if (existing && existing.dataset.themeOwned === 'true') existing.remove();
					return;
				}
				var navKind = oumPage ? 'oum' : 'luci';
				if (existing && existing.dataset.navKind !== navKind) { existing.remove(); existing = null; }
				if (existing) {
					var existingMain = document.querySelector('.oum-main');
					if (existingMain) existingMain.style.paddingBottom = '64px';
					return;
				}
				if (luciPage) {
					var topItems = document.querySelectorAll('#topmenu > li');
					if (!topItems.length) return;
					var fallback = ['Состояние', 'Система', 'Службы', 'Сеть'];
					var keys = ['status', 'network', 'services', 'system'];
					var icons = [
						'<path d="M3 12h4l2-6 4 12 2-6h6"/>',
						'<circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M4.9 4.9 7 7m10 10 2.1 2.1M2 12h3m14 0h3M4.9 19.1 7 17m10-10 2.1-2.1"/>',
						'<rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 7h.01M7 17h.01"/>',
						'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>'
					];
					var nav = document.createElement('nav');
					nav.className = 'oum-bottom-nav oum-luci-bottom-nav';
					nav.dataset.themeOwned = 'true'; nav.dataset.navKind = 'luci';
					nav.setAttribute('aria-label', 'Разделы LuCI');
					for (var li = 0; li < Math.min(4, topItems.length); li++) {
						var source = document.querySelector('#topmenu > li[data-oum-section="' + keys[li] + '"]');
						if (!source) continue;
						var sourceAnchor = source.querySelector(':scope > a');
						var btn = document.createElement('button');
						btn.type = 'button'; btn.dataset.luciSection = keys[li];
						btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + icons[({status:0,system:1,services:2,network:3})[keys[li]]] + '</svg><span>' + ((sourceAnchor && sourceAnchor.textContent.trim()) || fallback[li]) + '</span>';
						if (source.classList.contains('active') || source.classList.contains('open')) { btn.classList.add('active'); btn.setAttribute('aria-current', 'page'); }
						btn.addEventListener('click', function() { openLuciSection(this.dataset.luciSection); });
						nav.appendChild(btn);
					}
					document.body.appendChild(nav);
					document.body.classList.add('oum-has-mobile-nav');
					return;
				}
				var current = location.pathname.indexOf('/parental') !== -1 ? 'parental' :
					(location.pathname.indexOf('/settings') !== -1 ? 'settings' :
					(location.pathname.indexOf('/help') !== -1 ? 'help' : 'dashboard'));
				var nav = document.createElement('nav');
				nav.className = 'oum-bottom-nav';
				nav.dataset.themeOwned = 'true'; nav.dataset.navKind = 'oum';
				nav.setAttribute('aria-label', 'Основная навигация');
				nav.innerHTML = '<button type="button" data-nav="dashboard" aria-label="Главная"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg><span>Главная</span></button>' +
					'<button type="button" data-nav="parental" aria-label="Родительский контроль"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg><span>Контроль</span></button>' +
					'<button type="button" data-nav="settings" aria-label="Настройки"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span>Настройки</span></button>' +
					'<button type="button" data-nav="help" aria-label="Помощь"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-1.5 2-1.5 3"/><circle cx="12" cy="17" r=".8" fill="currentColor" stroke="none"/></svg><span>Помощь</span></button>';
				var routes = { dashboard: 'dashboard', parental: 'parental', settings: 'settings', help: 'help' };
				var buttons = nav.querySelectorAll('button[data-nav]');
				for (var i = 0; i < buttons.length; i++) {
					var button = buttons[i];
					var target = button.dataset.nav;
					if (target === current) {
						button.classList.add('active');
						button.setAttribute('aria-current', 'page');
					}
					button.addEventListener('click', function() {
						location.href = '/cgi-bin/luci/oum/' + routes[this.dataset.nav];
					});
				}
				document.body.appendChild(nav);
				var main = document.querySelector('.oum-main');
				if (main) main.style.paddingBottom = '64px';
			}
			function removeLegacyActions() {
				var actions = document.querySelectorAll('.oum-page-head #oum-theme-toggle, .oum-page-head a[href*="/logout"]');
				for (var i = 0; i < actions.length; i++) actions[i].remove();
				if (document.querySelector('.oum-app') && legacyObserver) legacyObserver.disconnect();
			}
			var OUM_DIST = '{{ version.distname }} {{ version.distversion }}';
			var menuOpener = null;
			var mobileMenu = null, luciSectionMenu = null, menuVpnBtn = null, menuSegBtns = [];
			function closeLuciSection() {
				if (luciSectionMenu) { luciSectionMenu.remove(); if (menuOpener && menuOpener.isConnected) menuOpener.focus(); }
				luciSectionMenu = null;
				document.body.classList.remove('oum-menu-open');
			}
			function openLuciSection(key) {
				var source = document.querySelector('#topmenu > li[data-oum-section="' + key + '"]');
				if (!source) return;
				menuOpener = document.activeElement;
				if (luciSectionMenu) luciSectionMenu.remove();
				var titleLink = source.querySelector(':scope > a');
				var links = source.querySelectorAll('.dropdown-menu a');
				var wrap = document.createElement('div');
				wrap.id = 'oum-luci-section-menu';
				var panel = document.createElement('div');
				panel.className = 'oum-mobile-menu-panel oum-luci-section-panel';
				panel.setAttribute('role', 'dialog'); panel.setAttribute('aria-modal', 'true');
				panel.innerHTML = '<span class="oum-mobile-menu-handle" aria-hidden="true"></span><header class="oum-mobile-menu-head"><h3>' + ((titleLink && titleLink.textContent.trim()) || 'Раздел') + '</h3><button type="button" class="oum-mobile-menu-close" aria-label="Закрыть">×</button></header><div class="oum-luci-section-links"></div>';
				var list = panel.querySelector('.oum-luci-section-links');
				if (titleLink && titleLink.getAttribute('href') && titleLink.getAttribute('href') !== '#') {
					var overview = document.createElement('a'); overview.href = titleLink.href; overview.textContent = 'Обзор раздела'; list.appendChild(overview);
				}
				for (var i = 0; i < links.length; i++) {
					var a = document.createElement('a'); a.href = links[i].href; a.textContent = links[i].textContent.trim();
					if (links[i].parentElement && links[i].parentElement.classList.contains('active')) { a.className = 'is-active'; a.setAttribute('aria-current', 'page'); }
					list.appendChild(a);
				}
				wrap.appendChild(panel); document.body.appendChild(wrap); luciSectionMenu = wrap;
				panel.querySelector('.oum-mobile-menu-close').addEventListener('click', closeLuciSection);
				panel.querySelector('.oum-mobile-menu-close').focus();
				panel.setAttribute('aria-label', titleLink ? titleLink.textContent.trim() : 'Раздел');
				wrap.addEventListener('click', function(ev) { if (ev.target === wrap) closeLuciSection(); });
				var touchY = null, dragY = 0, canDrag = false;
				panel.addEventListener('touchstart', function(ev) {
					if (ev.touches.length !== 1) return;
					touchY = ev.touches[0].clientY; dragY = 0;
					canDrag = panel.scrollTop <= 0;
				}, { passive: true });
				panel.addEventListener('touchmove', function(ev) {
					if (touchY == null || !canDrag || ev.touches.length !== 1) return;
					dragY = Math.max(0, ev.touches[0].clientY - touchY);
					if (dragY > 0) { panel.style.transform = 'translateY(' + Math.min(dragY, 180) + 'px)'; ev.preventDefault(); }
				}, { passive: false });
				panel.addEventListener('touchend', function() {
					if (touchY == null) return;
					if (dragY > 72) { closeLuciSection(); return; }
					panel.style.transform = '';
					touchY = null; dragY = 0; canDrag = false;
				}, { passive: true });
				document.body.classList.add('oum-menu-open');
			}
			function oumUbus(method, params, cb) {
				var sid = (window.L && L.env && L.env.sessionid) ? L.env.sessionid : '00000000000000000000000000000000';
				var url = (window.L && L.env && L.env.ubuspath) ? L.env.ubuspath : '/ubus/';
				fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'call', params: [ sid, 'oum', method, params || {} ] }) })
					.then(function(r) { return r.json(); })
					.then(function(j) {
						var res = (j && j.result && j.result[1]) ? j.result[1] : null;
						if (res && res.ok === false) cb(new Error(res.message || 'Ошибка операции'));
						else cb(null, res);
					})
					.catch(cb);
			}
			function vpnEnabledGuess() {
				var t = document.querySelector('#vpn-toggle');
				if (t && t.textContent) { var s = t.textContent.trim(); if (s === 'Отключить') return true; if (s === 'Включить') return false; }
				var h = document.querySelector('#header-vpn-state');
				if (h && h.dataset) { if (h.dataset.state === 'off') return false; if (h.dataset.state === 'good' || h.dataset.state === 'warn') return true; }
				return true;
			}
			function paintMenuTheme() {
				var selectedMode = localStorage.getItem('oum-theme-mode') || 'light';
				for (var i = 0; i < menuSegBtns.length; i++) {
					var b = menuSegBtns[i], ac = b.getAttribute('data-theme-mode') === selectedMode;
					b.classList.toggle('is-active', ac);
					b.setAttribute('aria-pressed', String(ac));
				}
			}
			function paintMenuVpn() {
				var on = vpnEnabledGuess();
				if (menuVpnBtn) { menuVpnBtn.textContent = on ? '◉ Отключить VPN' : '◉ Включить VPN'; menuVpnBtn.setAttribute('data-vpn-on', on ? '1' : '0'); }
			}
			function setMode(mode) {
				localStorage.setItem('oum-theme-mode', mode);
				var select=document.getElementById('oum-theme-select'); if(select)select.value=mode;
				localStorage.setItem('oum-theme', mode);
				// Proton's native settings sync persists this preference to the router.
				localStorage.setItem('proton-theme-mode', mode);
				applyMode(mode);
				var themeColor = document.querySelector('meta[name="theme-color"]');
				if (themeColor) themeColor.setAttribute('content', root.getAttribute('data-theme') === 'dark' ? '#0f1622' : '#eef0ea');
				paintMenuTheme();
			}
			function ensureMobileMenu() {
				if (mobileMenu) return mobileMenu;
				var luciLink = sidebar ? sidebar.querySelector('a.oum-luci-admin') : null;
				var logoutLink = sidebar ? sidebar.querySelector('a.oum-logout') : null;
				var luciHref = luciLink ? luciLink.getAttribute('href') : '/cgi-bin/luci/admin';
				var luciLabel = luciHref.indexOf('/admin') >= 0 ? 'Стандартный LuCI' : 'Вернуться в OUM';
				var logoutHref = logoutLink ? logoutLink.getAttribute('href') : '/cgi-bin/luci/oum/logout';
				var m = document.createElement('div');
				m.id = 'oum-mobile-menu'; m.hidden = true;
				var p = document.createElement('div');
				p.className = 'oum-mobile-menu-panel';
				p.setAttribute('role', 'dialog'); p.setAttribute('aria-modal', 'true'); p.setAttribute('aria-label', 'Меню');
				p.innerHTML = '<span class="oum-mobile-menu-handle" aria-hidden="true"></span>' +
					'<header class="oum-mobile-menu-head"><h3>Меню</h3><button type="button" class="oum-mobile-menu-close" aria-label="Закрыть">×</button></header>' +
					'<a class="oum-mobile-menu-luci" href="' + luciHref + '"><span>' + luciLabel + '</span><b aria-hidden="true">›</b></a>' +
					'<div class="oum-mobile-menu-theme"><span>Тема</span><div class="oum-apple-segment oum-mobile-menu-seg"><button type="button" data-theme-mode="dark">Тёмная</button><button type="button" data-theme-mode="light">Светлая</button><button type="button" data-theme-mode="auto">Системная</button></div></div>' +
					'<button type="button" class="oum-mobile-menu-btn is-danger" data-menu-act="vpn">◉ Отключить VPN</button>' +
					'<button type="button" class="oum-mobile-menu-btn" data-menu-act="reboot">○ Перезагрузка</button>' +
					'<button type="button" class="oum-mobile-menu-btn is-danger-text" data-menu-act="logout">Выйти</button>' +
					'<small class="oum-mobile-menu-foot">' + OUM_DIST + ' · OUM</small>';
				m.appendChild(p);
				document.body.appendChild(m);
				mobileMenu = m;
				menuVpnBtn = p.querySelector('[data-menu-act="vpn"]');
				menuSegBtns = Array.prototype.slice.call(p.querySelectorAll('[data-theme-mode]'));
				p.querySelector('.oum-mobile-menu-close').addEventListener('click', closeMenu);
				m.addEventListener('click', function(ev) { if (ev.target === m) closeMenu(); });
				for (var i = 0; i < menuSegBtns.length; i++) {
					menuSegBtns[i].addEventListener('click', function() { setMode(this.getAttribute('data-theme-mode')); });
				}
				p.querySelector('[data-menu-act="reboot"]').addEventListener('click', function() {
					var btn = this;
					if (!window.confirm('Перезагрузить роутер? Соединение прервётся примерно на минуту.')) return;
					btn.disabled = true;
					oumUbus('rebootRouter', {}, function(err) {
						btn.disabled = false;
						if (err) { window.alert(err.message); return; }
						closeMenu();
						window.alert('Роутер перезагружается. Подождите минуту и снова откройте панель OUM.');
					});
				});
				menuVpnBtn.addEventListener('click', function() {
					var btn = this, on = btn.getAttribute('data-vpn-on') !== '0';
					btn.disabled = true;
					oumUbus('setVpnEnabled', { enabled: !on }, function(err) {
						btn.disabled = false;
						if (err) { window.alert(err.message); return; }
						closeMenu();
						window.setTimeout(function() { window.location.reload(); }, 900);
					});
				});
				p.querySelector('[data-menu-act="logout"]').addEventListener('click', function() { window.location.href = logoutHref; });
				var touchY = null, touchScrolled = false;
				p.addEventListener('touchstart', function(ev) { if (ev.touches.length !== 1) return; touchY = ev.touches[0].clientY; touchScrolled = false; try { for (var el = ev.target; el; el = el.parentElement) { if (el.scrollHeight > el.clientHeight + 4 && el.scrollTop > 0) { touchScrolled = true; break; } if (el === p) break; } } catch (_) {} try { if (touchY - p.getBoundingClientRect().top < 72) touchScrolled = false; } catch (_) {} }, { passive: true });
				p.addEventListener('touchend', function(ev) {
					if (touchY == null || !ev.changedTouches.length) return;
					var d = ev.changedTouches[0].clientY - touchY;
					if (d > 90 && !touchScrolled) closeMenu();
					touchY = null;
				}, { passive: true });
				return m;
			}
			function openMobileMenu() {
				var m = ensureMobileMenu();
				paintMenuTheme();
				paintMenuVpn();
				m.hidden = false;
				if (menuToggle) menuToggle.setAttribute('aria-expanded', 'true');
				document.body.classList.add('oum-menu-open');
				var c = m.querySelector('.oum-mobile-menu-close');
				if (c) window.setTimeout(function() { c.focus(); }, 210);
			}
			function applyMode(mode) {
				var dark = mode === 'dark' || (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				root.setAttribute('data-theme', dark ? 'dark' : 'light');
				root.setAttribute('data-darkmode', dark ? 'true' : 'false');
				var apps = document.querySelectorAll('.oum-app, .oum-shell, .oum-parental, .oum-help-page');
				for (var i = 0; i < apps.length; i++) apps[i].setAttribute('data-theme', dark ? 'dark' : 'light');
				if (toggle) toggle.textContent = dark ? 'Светлая' : 'Тёмная';
				paintMenuTheme();
			}
			function closeMenu() {
				if (sidebar) sidebar.classList.remove('is-open');
				if (overlay) overlay.hidden = true;
				if (mobileMenu) mobileMenu.hidden = true;
				closeLuciSection();
				if (menuToggle) menuToggle.setAttribute('aria-expanded', 'false');
				document.body.classList.remove('oum-menu-open');
			}
			function openMenu() {
				if (window.innerWidth <= 900) { openMobileMenu(); return; }
				if (!sidebar || !overlay || !menuToggle) return;
				sidebar.classList.add('is-open');
				overlay.hidden = false;
				menuToggle.setAttribute('aria-expanded', 'true');
				document.body.classList.add('oum-menu-open');
				var firstLink = sidebar.querySelector('a, button');
				if (firstLink) window.setTimeout(function() { firstLink.focus(); }, 210);
			}
			if (toggle) toggle.addEventListener('click', function() {
				setMode(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
			});
			if (menuToggle) menuToggle.addEventListener('click', function() {
				var mobileOpen = window.innerWidth <= 900 && mobileMenu && !mobileMenu.hidden;
				var open = !mobileOpen && !sidebar.classList.contains('is-open');
				if (open) openMenu(); else closeMenu();
			});
			if (overlay) overlay.addEventListener('click', closeMenu);
			if (sidebar) sidebar.addEventListener('click', function(event) {
				if (window.innerWidth <= 900 && event.target.closest('a')) closeMenu();
			});
			document.addEventListener('keydown', function(event) { if (event.key === 'Escape') closeMenu(); });
			window.addEventListener('resize', function() { if (window.innerWidth > 900) closeMenu(); ensureMobileBottomNav(); });
			var touchStartX = null;
			document.addEventListener('touchstart', function(event) {
				if (event.touches.length !== 1) return;
				var x = event.touches[0].clientX;
				if ((sidebar && sidebar.classList.contains('is-open')) || x <= 24) touchStartX = x;
			}, { passive: true });
			document.addEventListener('touchend', function(event) {
				if (touchStartX == null || !event.changedTouches.length || window.innerWidth > 900) return;
				var delta = event.changedTouches[0].clientX - touchStartX;
				if (delta > 64 && touchStartX <= 24) openMenu();
				else if (delta < -64 && sidebar && sidebar.classList.contains('is-open')) closeMenu();
				touchStartX = null;
			}, { passive: true });
			legacyObserver = new MutationObserver(removeLegacyActions);
			legacyObserver.observe(document.getElementById('maincontent'), { childList: true, subtree: true });
			removeLegacyActions();
			applyMode(localStorage.getItem('oum-theme-mode') || root.getAttribute('data-theme'));
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() { if (localStorage.getItem('oum-theme-mode') === 'auto') setMode('auto'); });
			ensureMobileBottomNav();
			window.setTimeout(ensureMobileBottomNav, 500);
		})();
		L.require('menu-oum-app').then(function() { window.dispatchEvent(new Event('resize')); });
		</script>
		{% endif %}
	</body>
</html>
