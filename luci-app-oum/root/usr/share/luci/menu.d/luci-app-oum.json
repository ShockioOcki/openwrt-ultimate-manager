{
	"oum": {
		"title": "OUM",
		"order": 1,
		"action": {
			"type": "alias",
			"path": "oum/dashboard"
		},
		"auth": {
			"methods": [ "cookie:sysauth_https", "cookie:sysauth_http" ],
			"login": true
		}
	},
	"oum/setup": {
		"firstchild_ineligible": true,
		"action": {
			"type": "view",
			"path": "oum/first-run"
		},
		"depends": {
			"acl": [ "luci-app-oum" ]
		}
	},
	"oum/dashboard": {
		"title": "Главная",
		"order": 2,
		"action": {
			"type": "view",
			"path": "oum/dashboard"
		},
		"depends": {
			"acl": [ "luci-app-oum" ],
			"uci": { "oum": true }
		}
	},
	"oum/settings": {
		"title": "Настройки",
		"order": 3,
		"action": {
			"type": "view",
			"path": "oum/settings"
		},
		"depends": {
			"acl": [ "luci-app-oum" ],
			"uci": { "oum": true }
		}
	}
}
