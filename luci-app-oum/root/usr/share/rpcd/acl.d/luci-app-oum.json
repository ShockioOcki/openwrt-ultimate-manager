{
	"luci-app-oum": {
		"description": "Access the simplified OUM router manager",
		"read": {
			"ubus": {
				"luci": [ "getFeatures" ],
				"oum": [ "status", "dashboardStatus", "nodeStatus", "measureNodeDelays", "vpnJobStatus" ],
				"session": [ "access" ]
			},
			"uci": [ "oum" ]
		},
		"write": {
			"ubus": {
				"oum": [ "applySetup", "startVpnImport", "selectNode", "setVpnEnabled", "setDevicePolicy" ]
			},
			"uci": [ "oum" ]
		}
	}
}
