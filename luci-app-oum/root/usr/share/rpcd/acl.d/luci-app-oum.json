{
	"luci-app-oum": {
		"description": "Access the simplified OUM router manager",
		"read": {
			"ubus": {
				"luci": [ "getFeatures" ],
				"oum": [ "status", "dashboardStatus", "nodeStatus", "measureNodeDelays", "vpnJobStatus", "settingsStatus", "systemJobStatus", "podkopRoutingStatus", "podkopDiagnostics" ],
				"session": [ "access" ]
			},
			"uci": [ "oum" ]
		},
		"write": {
			"ubus": {
				"oum": [ "applySetup", "startVpnImport", "selectNode", "setVpnEnabled", "setDevicePolicy", "refreshSubscriptionInfo", "applyWifiSettings", "applyWanSettings", "rollbackSettings", "switchVpnEngine", "configurePodkop", "applyPodkopRouting", "createBackup", "restoreBackup", "resetVpn", "resetFirstRun" ]
			},
			"uci": [ "oum" ]
		}
	}
}
