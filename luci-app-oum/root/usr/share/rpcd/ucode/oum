function vpnReady() {
	if (podkopInstalled())
		return system("pidof sing-box >/dev/null 2>&1 && nft list table inet PodkopTable >/dev/null 2>&1") == 0;
	if (passwallInstalled())
		return system("pidof xray >/dev/null 2>&1 && nft list table inet passwall >/dev/null 2>&1") == 0;
	return system("pidof clash >/dev/null 2>&1 && nft list chain inet fw4 openclash 2>/dev/null | grep -q 'redirect to :7892'") == 0;
}

function podkopStatusData() {
	if (!podkopInstalled())
		return { installed: false, enabled: false, ready: false, zapret: false, interface: '' };
	const uci = cursor();
	let iface = uci.get('podkop', 'main', 'interface') ?? '';
	let connectionType = uci.get('podkop', 'main', 'connection_type') ?? '';
	let proxyString = uci.get('podkop', 'main', 'proxy_string') ?? '';
	let endpointMatch = match(proxyString, /@([^:\/?#]+):([0-9]+)/);
	let bus = connect();
	let tunnel = length(iface) ? (bus?.call(`network.interface.${iface}`, 'status') ?? {}) : {};
	let options = zapretOptions();
	let zapretMarker = null;
	for (let line in split(options, '\n')) {
		let candidate = match(line, /^#OUM_YOUTUBE (Yv[0-9][0-9])$/);
		if (candidate) zapretMarker = candidate;
	}
	return {
		installed: true,
		enabled: system('/etc/init.d/podkop enabled >/dev/null 2>&1') == 0,
		ready: system('pidof sing-box >/dev/null 2>&1 && nft list table inet PodkopTable >/dev/null 2>&1') == 0,
		zapret: system("pgrep -f '/opt/zapret/nfq/nfqws' >/dev/null 2>&1") == 0,
		interface: iface,
		transport: connectionType == 'proxy' ? 'reality' : 'awg',
		proxy_endpoint: endpointMatch ? `${endpointMatch[1]}:${endpointMatch[2]}` : '',
		tunnel_up: tunnel.up == true,
		version: packageVersion('podkop'),
		zapret_version: packageVersion('zapret'),
		zapret_strategy: zapretMarker ? zapretMarker[1] : '',
		youtube_mode: uci.get('oum', 'main', 'youtube_mode') ?? 'zapret'
	};
}

function podkopList(uci, section, option) {
	let value = uci.get('podkop', section, option);
	let source = type(value) == 'array' ? value : (type(value) == 'string' && length(value) ? [ value ] : []);
	let result = [];
	let seen = {};
	for (let item in source) {
		if (!length(item) || seen[item]) continue;
		seen[item] = true;
		push(result, item);
	}
	return result;
}

