'use strict';

import { access, basename, dirname, glob, open, popen, readfile } from 'fs';
import { cursor } from 'uci';
import { connect } from 'ubus';

const CONFIGS = [ 'network', 'wireless', 'rpcd', 'oum' ];
const BACKUP_DIR = '/tmp/oum-setup-backup';
const VPN_JOB_DIR = '/tmp/oum-vpn-job';
const SUBSCRIPTION_CACHE = '/tmp/oum-subscription-info.json';
const SYSTEM_JOB_DIR = '/tmp/oum-system-job';
const SYSTEM_JOB_LOCK = '/tmp/oum-system-job.lock';
const BACKUP_ENCODED = '/tmp/oum-backup.b64';
const RESTORE_INPUT = '/tmp/oum-restore.b64';
const PASSWALL_NODE_CACHE = '/tmp/oum-passwall-nodes.cache';

function shellquote(value) {
	return `'${replace(value ?? '', "'", "'\\''")}'`;
}

function failure(code, message) {
	return { ok: false, code, message };
}

function writePrivate(path, value) {
	let file = open(path, 'w');
	if (!file)
		return false;
	file.write(value);
	file.close();
	return system(`chmod 600 ${path}`) == 0;
}

function vpnJobStatus() {
	let raw = readfile(`${VPN_JOB_DIR}/status`);
	if (!raw)
		return { state: 'idle', code: '', message: '' };

	let result = { state: 'idle', code: '', message: '' };
	for (let line in split(raw, '\n')) {
		let pair = match(line, /^(state|code|message)=(.*)$/);
		if (pair)
			result[pair[1]] = pair[2];
	}
	return result;
}

function readKeyValues(path, allowed) {
	let result = {};
	let raw = readfile(path) ?? '';
	for (let line in split(raw, '\n')) {
		let pair = match(line, /^([a-z_]+)=(.*)$/);
		if (pair && pair[1] in allowed)
			result[pair[1]] = pair[2];
	}
	return result;
}

function systemJobStatus() {
	let values = readKeyValues(`${SYSTEM_JOB_DIR}/status`, [ 'state', 'action', 'code', 'message' ]);
	return {
		state: values.state ?? 'idle',
		action: values.action ?? '',
		code: values.code ?? '',
		message: values.message ?? ''
	};
}

function configurationBusy() {
	return access(SYSTEM_JOB_LOCK) ||
		access('/tmp/oum-device-policy.lock') || access('/tmp/oum-passwall-nodes.lock') ||
		access('/tmp/oum-passwall-nodes.start') ||
		vpnJobStatus().state == 'running';
}

function startSystemJob(action, payload, inputPath, inputData) {
	if (!access('/usr/libexec/oum-system-job'))
		return failure('runtime_missing', 'Компонент системных настроек не установлен.');
	if (configurationBusy())
		return failure('configuration_busy', 'Дождитесь завершения текущей операции.');
	if (system(`mkdir ${SYSTEM_JOB_LOCK}`) != 0)
		return failure('configuration_busy', 'Другая операция уже выполняется.');
	if (system(`rm -rf ${SYSTEM_JOB_DIR} && mkdir -p ${SYSTEM_JOB_DIR} && chmod 700 ${SYSTEM_JOB_DIR}`) != 0 ||
		!writePrivate(`${SYSTEM_JOB_DIR}/request.json`, sprintf('%J', payload ?? {})) ||
		(length(inputPath ?? '') && !writePrivate(inputPath, inputData ?? '')) ||
		!writePrivate(`${SYSTEM_JOB_DIR}/status`, `state=running\naction=${action}\ncode=queued\nmessage=Операция поставлена в очередь.\n`)) {
		system(`rm -rf ${SYSTEM_JOB_DIR}; rmdir ${SYSTEM_JOB_LOCK}`);
		if (length(inputPath ?? ''))
			system(`rm -f ${inputPath}`);
		return failure('job_prepare', 'Не удалось подготовить операцию.');
	}
	if (system(`(/usr/libexec/oum-system-job ${action}) >/tmp/oum-system-job.log 2>&1 &`) != 0) {
		system(`rmdir ${SYSTEM_JOB_LOCK}`);
		if (length(inputPath ?? ''))
			system(`rm -f ${inputPath}`);
		return failure('job_start', 'Не удалось запустить операцию.');
	}
	return { ok: true, state: 'running', action };
}

function wirelessStations() {
	let stations = {};
	for (let path in glob('/sys/class/net/*/wireless')) {
		let device = basename(dirname(path));
		let process = popen(`/usr/bin/iwinfo ${device} assoclist 2>/dev/null`);
		if (!process)
			continue;
		for (let line = process.read('line'); length(line); line = process.read('line')) {
			let mac = match(line, /^([0-9A-Fa-f:]{17})\s/);
			if (mac)
				stations[uc(mac[1])] = true;
		}
		process.close();
	}
	return stations;
}

function connectedClients(uci) {
	let result = [];
	let stations = wirelessStations();
	let policies = {};
	uci.foreach('oum', 'device', (device) => {
		if (match(device.mac ?? '', /^[0-9A-Fa-f:]{17}$/))
			policies[uc(device.mac)] = device.policy ?? 'default';
	});
	let leases = readfile('/tmp/dhcp.leases') ?? '';
	for (let line in split(leases, '\n')) {
		let fields = match(line, /^(\d+)\s+([0-9A-Fa-f:]{17})\s+(\S+)\s+(\S+)/);
		if (!fields)
			continue;
		let mac = uc(fields[2]);
		push(result, {
			name: fields[4] == '*' ? 'Неизвестное устройство' : fields[4],
			mac,
			ip: fields[3],
			medium: stations[mac] ? 'wifi' : 'ethernet',
			expires: +fields[1],
			policy: policies[mac] ?? 'default'
		});
	}
	return result;
}

function thermalStatus() {
	let sensors = [];
	let maximum = null;
	for (let path in glob('/sys/class/thermal/thermal_zone*/temp')) {
		let directory = dirname(path);
		let raw = +trim(readfile(path) ?? '0');
		if (!raw)
			continue;
		let value = raw > 1000 ? raw / 1000 : raw;
		let name = trim(readfile(`${directory}/type`) ?? basename(directory));
		push(sensors, { name, value });
		if (maximum == null || value > maximum)
			maximum = value;
	}
	return { maximum, sensors };
}

function wifiStatus(uci) {
	let networks = [];
	uci.foreach('wireless', 'wifi-iface', (iface) => {
		if (iface.mode == 'ap' && iface.disabled != '1' && length(iface.ssid ?? ''))
			push(networks, { ssid: iface.ssid, device: iface.device ?? '' });
	});
	return networks;
}

function networkStatus() {
	let result = { up: false, ipv4: '', device: '', proto: '' };
	let bus = connect();
	let status = bus?.call('network.interface.wan', 'status');
	if (!status)
		return result;
	result.up = status.up == true;
	result.device = status.l3_device ?? status.device ?? '';
	result.proto = status.proto ?? '';
	result.ipv4 = status['ipv4-address']?.[0]?.address ?? '';
	return result;
}

function capabilityStatus() {
	let usbNetwork = system("for path in /sys/class/net/*/device; do target=$(readlink -f \"$path\") || continue; case \"$target\" in */usb*/*) exit 0;; esac; done; exit 1") == 0;
	let mobileControl = length(glob('/dev/cdc-wdm*')) > 0 || length(glob('/dev/ttyUSB*')) > 0;
	return {
		mesh_driver: system("iw list 2>/dev/null | grep -q 'mesh point'") == 0,
		mesh_runtime: system("apk info 2>/dev/null | grep -Eq '^wpad($|-(mesh-)?(mbedtls|openssl|wolfssl)$)'") == 0,
		usb_host: length(glob('/sys/bus/usb/devices/usb*')) > 0,
		usb_storage: length(glob('/sys/class/block/sd*')) > 0,
		usb_network: usbNetwork,
		usb_modem: mobileControl
	};
}

function settingsStatusData() {
	const uci = cursor();
	let bands = {};
	let accessPoints = [];
	uci.foreach('wireless', 'wifi-device', (radio) => {
		bands[radio['.name']] = radio.band ?? '';
	});
	uci.foreach('wireless', 'wifi-iface', (iface) => {
		if (iface.mode != 'ap' || iface.disabled == '1')
			return;
		push(accessPoints, {
			band: bands[iface.device] ?? '',
			ssid: iface.ssid ?? '',
			password_set: length(iface.key ?? '') > 0
		});
	});
	let ap24 = filter(accessPoints, (item) => item.band == '2g')[0] ?? accessPoints[0] ?? {};
	let ap5 = filter(accessPoints, (item) => item.band == '5g')[0] ?? accessPoints[1] ?? ap24;
	let wan = networkStatus();
	wan.username = uci.get('network', 'wan', 'username') ?? '';
	wan.password_set = length(uci.get('network', 'wan', 'password') ?? '') > 0;
	return {
		wifi: {
			mode: length(ap24.ssid ?? '') && ap24.ssid == ap5.ssid ? 'smart' : 'separate',
			ssid_24: ap24.ssid ?? '',
			ssid_5: ap5.ssid ?? '',
			password_set: ap24.password_set == true || ap5.password_set == true,
			country: 'US'
		},
		wan,
		capabilities: capabilityStatus(),
		rollback_wifi: access('/etc/oum/rollback/wireless') ? true : false,
		rollback_wan: access('/etc/oum/rollback/network') ? true : false
	};
}

function passwallInstalled() {
	return access('/etc/init.d/passwall') && access('/etc/config/passwall');
}

function vpnReady() {
	if (passwallInstalled())
		return system("pidof xray >/dev/null 2>&1 && nft list table inet passwall >/dev/null 2>&1") == 0;
	return system("pidof clash >/dev/null 2>&1 && nft list chain inet fw4 openclash 2>/dev/null | grep -q 'redirect to :7892'") == 0;
}

function packageVersion(name) {
	let process = popen(`/usr/bin/apk list --installed ${name} 2>/dev/null | cut -d' ' -f1`);
	if (!process)
		return '';
	let value = trim(process.read('line'));
	process.close();
	return replace(value, `${name}-`, '');
}

function passwallStatusData() {
	if (!passwallInstalled())
		return { installed: false, enabled: false, ready: false };

	const uci = cursor();
	let global = null;
	let forwarding = null;
	let nodes = {};
	let rules = [];
	uci.foreach('passwall', 'global', (section) => {
		if (!global)
			global = section;
	});
	uci.foreach('passwall', 'global_forwarding', (section) => {
		if (!forwarding)
			forwarding = section;
	});
	uci.foreach('passwall', 'nodes', (section) => {
		nodes[section['.name']] = section;
	});
	uci.foreach('passwall', 'shunt_rules', (section) => {
		push(rules, {
			name: section['.name'],
			label: section.remarks ?? section['.name'],
			has_sources: length(trim(section.source ?? '')) > 0
		});
	});

	let nodeLabel = (identifier) => {
		if (identifier == '_direct') return 'Напрямую';
		if (identifier == '_blackhole') return 'Блокировка';
		if (identifier == '_default') return 'По умолчанию';
		return nodes[identifier]?.remarks ?? identifier ?? 'Не выбран';
	};
	let tcpNode = global?.tcp_node ?? '';
	let selected = nodes[tcpNode]?.default_node ?? tcpNode;
	let geoSite = access('/usr/share/v2ray/geosite.dat');
	let geoIp = access('/usr/share/v2ray/geoip.dat');
	let dnsProcess = system("ps w | grep -q '[d]nsmasq_default'") == 0;
	let dnsRedirect = global?.dns_redirect == '1';
	let dnsFirewall = system("nft list chain inet passwall PSW_DNS 2>/dev/null | grep -q 'redirect to'") == 0;
	let ipv6Tproxy = forwarding?.ipv6_tproxy == '1';

	return {
		installed: true,
		enabled: global?.enabled == '1',
		ready: vpnReady(),
		xray: system('pidof xray >/dev/null 2>&1') == 0,
		dns: dnsProcess && dnsRedirect && dnsFirewall,
		firewall: system('nft list table inet passwall >/dev/null 2>&1') == 0,
		geo_ready: geoSite && geoIp,
		profile: nodeLabel(tcpNode),
		selected_node: nodeLabel(selected),
		rules,
		diagnostics: {
			dns_process: dnsProcess,
			dns_redirect: dnsRedirect,
			dns_firewall: dnsFirewall,
			dns_mode: global?.dns_mode ?? 'Не задан',
			direct_dns: global?.direct_dns ?? 'Не задан',
			remote_dns_mode: global?.v2ray_dns_mode ?? 'Не задан',
			ipv6_tproxy: ipv6Tproxy,
			geosite: geoSite,
			geoip: geoIp
		},
		versions: {
			passwall: packageVersion('luci-app-passwall'),
			xray: packageVersion('xray-core'),
			haproxy: packageVersion('haproxy')
		}
	};
}

function passwallNodeDelays() {
	let result = { measured_at: 0, delays: {} };
	let raw = readfile(PASSWALL_NODE_CACHE) ?? '';
	for (let line in split(raw, '\n')) {
		let stamp = match(line, /^timestamp ([0-9]+)$/);
		if (stamp) {
			result.measured_at = +stamp[1];
			continue;
		}
		let pair = match(line, /^([A-Za-z0-9_]+) ([0-9]+)$/);
		if (pair)
			result.delays[pair[1]] = +pair[2];
	}
	return result;
}

function passwallNodeExcluded(name) {
	let original = name ?? '';
	let value = lc(original);
	return match(original, /Мобильн|мобильн|Авто|АВТО|⬇️|🇪🇺/) ||
		match(value, /mobile|lte|auto/) ||
		match(value, /(^|[\s_|+\-])ss($|[\s_|+\-])/);
}

function passwallNodeStatusData() {
	if (!passwallInstalled())
		return { available: false, engine: 'passwall', current: '', current_id: '', nodes: [] };

	const uci = cursor();
	let global = null;
	let sections = {};
	uci.foreach('passwall', 'global', (section) => {
		if (!global)
			global = section;
	});
	uci.foreach('passwall', 'nodes', (section) => {
		sections[section['.name']] = section;
	});
	let tcpNode = global?.tcp_node ?? '';
	let currentId = sections[tcpNode]?.protocol == '_shunt' ?
		(sections[tcpNode]?.default_node ?? '') : tcpNode;
	let cached = passwallNodeDelays();
	let nodes = [];
	for (let identifier, section in sections) {
		let protocol = section.protocol ?? '';
		let label = section.remarks ?? identifier;
		if (identifier == tcpNode || match(protocol, /^_/) || !length(section.address ?? '') ||
			!length(section.port ?? '') || passwallNodeExcluded(label))
			continue;
		push(nodes, {
			id: identifier,
			name: label,
			type: section.type ?? protocol,
			delay: +(cached.delays[identifier] ?? 0),
			tested: identifier in cached.delays
		});
	}
	let current = sections[currentId]?.remarks ?? currentId;
	return {
		available: length(nodes) > 0,
		engine: 'passwall',
		applying: access('/tmp/oum-passwall-nodes.lock') || access('/tmp/oum-passwall-nodes.start') ? true : false,
		group: sections[tcpNode]?.remarks ?? tcpNode,
		current,
		current_id: currentId,
		measured_at: cached.measured_at,
		nodes
	};
}

function activeNodeGroup(uci) {
	let source = uci.get('oum', 'main', 'active_source') ?? 'none';
	if (source == 'subscription') return 'Subscription';
	if (source == 'awg') return 'AWG_Tunnel';
	if (source == 'proxy') return 'Proxy_Nodes';
	return null;
}

function readJsonFile(path) {
	let file = open(path, 'r');
	if (!file)
		return null;
	let value = json(file);
	file.close();
	return value;
}

function nodeStatusData() {
	if (passwallInstalled())
		return passwallNodeStatusData();
	const uci = cursor();
	let groupName = activeNodeGroup(uci);
	if (!groupName || !access('/usr/libexec/oum-mihomo-api'))
		return { available: false, group: '', current: '', nodes: [] };
	if (system('/usr/libexec/oum-mihomo-api list >/dev/null 2>&1') != 0)
		return { available: false, group: groupName, current: '', nodes: [] };
	let response = readJsonFile('/tmp/oum-mihomo-api/response.json');
	let proxies = response?.proxies ?? {};
	let group = proxies[groupName];
	if (!group || type(group.all) != 'array')
		return { available: false, group: groupName, current: '', nodes: [] };

	let nodes = [];
	for (let name in group.all) {
		let proxy = proxies[name] ?? {};
		let history = proxy.history ?? [];
		let delay = length(history) ? +(history[-1]?.delay ?? 0) : 0;
		push(nodes, { name, type: proxy.type ?? '', delay });
	}
	return { available: true, group: groupName, current: group.now ?? '', nodes };
}

function subscriptionStatusData(force) {
	const uci = cursor();
	if ((uci.get('oum', 'main', 'active_source') ?? 'none') != 'subscription')
		return { available: false, refreshing: false };

	let cached = readJsonFile(SUBSCRIPTION_CACHE);
	let checked = +(cached?.checked_at ?? 0);
	let stale = !checked || time() - checked > 1800;
	let running = access('/tmp/oum-subscription-info.lock') ? true : false;
	if ((force || stale) && access('/usr/libexec/oum-subscription-info'))
		system('(/usr/libexec/oum-subscription-info) >/tmp/oum-subscription-info.log 2>&1 &');

	return {
		available: cached?.available == true,
		refreshing: force || stale || running,
		checked_at: checked,
		upload: +(cached?.upload ?? 0),
		download: +(cached?.download ?? 0),
		total: +(cached?.total ?? 0),
		expire: +(cached?.expire ?? 0)
	};
}

function validSsid(value) {
	return type(value) == 'string' && length(value) >= 1 && length(value) <= 32 && !match(value, /[\r\n]/);
}

function validOptionalPassword(value) {
	return type(value) == 'string' && (!length(value) || (length(value) >= 8 && length(value) <= 63));
}

function validate(args) {
	if (!(args.wan_type in [ 'dhcp', 'pppoe' ]))
		return failure('invalid_wan', 'Выберите DHCP или PPPoE.');

	if (args.wan_type == 'pppoe' && (!length(args.pppoe_user ?? '') || !length(args.pppoe_password ?? '')))
		return failure('invalid_pppoe', 'Для PPPoE нужны логин и пароль провайдера.');

	if (!(args.wifi_mode in [ 'smart', 'separate' ]))
		return failure('invalid_wifi_mode', 'Выберите режим Wi-Fi.');

	if (!validSsid(args.ssid_24) || !validSsid(args.ssid_5))
		return failure('invalid_ssid', 'Имя Wi-Fi должно содержать от 1 до 32 символов.');

	if (type(args.wifi_password) != 'string' || length(args.wifi_password) < 8 || length(args.wifi_password) > 63)
		return failure('invalid_wifi_password', 'Пароль Wi-Fi должен содержать от 8 до 63 символов.');

	if (type(args.admin_password) != 'string' || length(args.admin_password) < 8)
		return failure('invalid_admin_password', 'Новый пароль панели должен содержать минимум 8 символов.');

	if (!(args.vpn_type in [ 'none', 'subscription', 'awg', 'proxy' ]))
		return failure('invalid_vpn', 'Неизвестный тип VPN.');

	return { ok: true };
}

function backupConfigs() {
	system(`rm -rf ${BACKUP_DIR} && mkdir -p ${BACKUP_DIR}`);
	for (let name in CONFIGS)
		if (access(`/etc/config/${name}`) && system(`cp /etc/config/${name} ${BACKUP_DIR}/${name}`) != 0)
			return false;
	if (system(`cp /etc/shadow ${BACKUP_DIR}/shadow`) != 0)
		return false;
	return true;
}

function restoreConfigs() {
	for (let name in CONFIGS)
		if (access(`${BACKUP_DIR}/${name}`))
			system(`cp ${BACKUP_DIR}/${name} /etc/config/${name}`);
	if (access(`${BACKUP_DIR}/shadow`))
		system(`cp ${BACKUP_DIR}/shadow /etc/shadow`);
}

function setRootPassword(password) {
	let quoted = shellquote(password);
	return system(`(echo ${quoted}; sleep 1; echo ${quoted}) | /bin/busybox passwd root >/dev/null 2>&1`) == 0;
}

function setAdminPassword(uci, password) {
	let proc = popen(`/usr/sbin/uhttpd -m ${shellquote(password)} 2>/dev/null`);
	if (!proc)
		return false;

	let hash = trim(proc.read('all'));
	let rc = proc.close();
	if (rc != 0 || !match(hash, /^\$1\$/))
		return false;

	let found = false;
	uci.foreach('rpcd', 'login', (section) => {
		if (section.username == 'admin') {
			uci.set('rpcd', section['.name'], 'password', hash);
			found = true;
		}
	});

	if (!found) {
		let section = uci.add('rpcd', 'login');
		uci.set('rpcd', section, 'username', 'admin');
		uci.set('rpcd', section, 'password', hash);
		uci.set('rpcd', section, 'read', [ 'luci-app-oum' ]);
		uci.set('rpcd', section, 'write', [ 'luci-app-oum' ]);
	}

	return true;
}

function configureWan(uci, args) {
	uci.set('network', 'wan', 'proto', args.wan_type);
	if (args.wan_type == 'pppoe') {
		uci.set('network', 'wan', 'username', args.pppoe_user);
		uci.set('network', 'wan', 'password', args.pppoe_password);
	}
	else {
		uci.delete('network', 'wan', 'username');
		uci.delete('network', 'wan', 'password');
	}
}

function configureWifi(uci, args) {
	let radios = {};
	uci.foreach('wireless', 'wifi-device', (radio) => {
		uci.set('wireless', radio['.name'], 'country', 'US');
		radios[radio['.name']] = radio.band ?? '';
	});

	uci.foreach('wireless', 'wifi-iface', (iface) => {
		if (iface.mode != 'ap' || !(iface.device in radios))
			return;

		let ssid = radios[iface.device] == '2g' ? args.ssid_24 : args.ssid_5;
		uci.set('wireless', iface['.name'], 'network', 'lan');
		uci.set('wireless', iface['.name'], 'ssid', ssid);
		uci.set('wireless', iface['.name'], 'encryption', 'sae-mixed');
		uci.set('wireless', iface['.name'], 'key', args.wifi_password);
		uci.set('wireless', iface['.name'], 'disabled', '0');
	});
}

const methods = {
	status: {
		call: function() {
			const uci = cursor();
			const capabilities = capabilityStatus();
			return {
				setup_complete: uci.get('oum', 'main', 'setup_complete') == '1',
				setup_step: uci.get('oum', 'main', 'setup_step') ?? 'internet',
				active_source: uci.get('oum', 'main', 'active_source') ?? 'none',
				pending_source: uci.get('oum', 'main', 'pending_source') ?? 'none',
				usb_present: capabilities.usb_storage,
				capabilities,
				country: 'US'
			};
		}
	},

	settingsStatus: {
		call: function() {
			try {
				return settingsStatusData();
			}
			catch (err) {
				return failure('settings_read_failed', `Не удалось прочитать настройки: ${err}`);
			}
		}
	},

	systemJobStatus: {
		call: function() {
			return systemJobStatus();
		}
	},

	applyWifiSettings: {
		args: { wifi_mode: '', ssid_24: '', ssid_5: '', wifi_password: '' },
		call: function(request) {
			let args = request.args;
			if (!(args.wifi_mode in [ 'smart', 'separate' ]))
				return failure('invalid_wifi_mode', 'Выберите режим Wi-Fi.');
			if (!validSsid(args.ssid_24) || (args.wifi_mode == 'separate' && !validSsid(args.ssid_5)))
				return failure('invalid_ssid', 'Имя Wi-Fi должно содержать от 1 до 32 символов без перевода строки.');
			if (!validOptionalPassword(args.wifi_password) || match(args.wifi_password, /[\r\n]/))
				return failure('invalid_wifi_password', 'Новый пароль Wi-Fi должен содержать от 8 до 63 символов.');
			let current = settingsStatusData();
			if (!length(args.wifi_password) && !current.wifi.password_set)
				return failure('wifi_password_missing', 'Задайте пароль Wi-Fi.');
			return startSystemJob('wifi', {
				wifi_mode: args.wifi_mode,
				ssid_24: args.ssid_24,
				ssid_5: args.wifi_mode == 'smart' ? args.ssid_24 : args.ssid_5,
				wifi_password: args.wifi_password
			});
		}
	},

	applyWanSettings: {
		args: { wan_type: '', pppoe_user: '', pppoe_password: '' },
		call: function(request) {
			let args = request.args;
			if (!(args.wan_type in [ 'dhcp', 'pppoe' ]))
				return failure('invalid_wan', 'Выберите DHCP или PPPoE.');
			if (type(args.pppoe_user) != 'string' || length(args.pppoe_user) > 128 || match(args.pppoe_user, /[\r\n]/) ||
				type(args.pppoe_password) != 'string' || length(args.pppoe_password) > 256 || match(args.pppoe_password, /[\r\n]/))
				return failure('invalid_pppoe', 'Некорректные данные PPPoE.');
			if (args.wan_type == 'pppoe' && !length(args.pppoe_user))
				return failure('invalid_pppoe', 'Введите логин PPPoE.');
			let current = settingsStatusData();
			if (args.wan_type == 'pppoe' && !length(args.pppoe_password) && !current.wan.password_set)
				return failure('pppoe_password_missing', 'Введите пароль PPPoE.');
			return startSystemJob('wan', {
				wan_type: args.wan_type,
				pppoe_user: args.pppoe_user,
				pppoe_password: args.pppoe_password
			});
		}
	},

	rollbackSettings: {
		args: { kind: '' },
		call: function(request) {
			let kind = request.args.kind ?? '';
			if (!(kind in [ 'wifi', 'wan' ]))
				return failure('invalid_kind', 'Неизвестный тип настроек.');
			return startSystemJob(`rollback_${kind}`, {});
		}
	},

	createBackup: {
		call: function() {
			if (!access('/usr/libexec/oum-backup') || !access('/usr/libexec/oum-backup-codec.rb'))
				return failure('runtime_missing', 'Компонент резервного копирования не установлен.');
			if (configurationBusy())
				return failure('configuration_busy', 'Дождитесь завершения текущей операции.');
			if (system(`mkdir ${SYSTEM_JOB_LOCK}`) != 0)
				return failure('configuration_busy', 'Другая операция уже выполняется.');
			system(`rm -f ${BACKUP_ENCODED}`);
			if (system('/usr/libexec/oum-backup create >/tmp/oum-backup.log 2>&1') != 0) {
				system(`rmdir ${SYSTEM_JOB_LOCK}`);
				return failure('backup_failed', 'Не удалось создать резервную копию.');
			}
			let data = readfile(BACKUP_ENCODED);
			system(`rm -f ${BACKUP_ENCODED}`);
			system(`rmdir ${SYSTEM_JOB_LOCK}`);
			if (!data || !length(data))
				return failure('backup_empty', 'Резервная копия получилась пустой.');
			return { ok: true, filename: `oum-backup-${time()}.oum`, data };
		}
	},

	restoreBackup: {
		args: { data: '' },
		call: function(request) {
			let data = request.args.data;
			if (type(data) != 'string' || length(data) < 32 || length(data) > 4194304 || !match(data, /^[A-Za-z0-9+\/=\r\n]+$/))
				return failure('invalid_backup', 'Файл резервной копии повреждён или слишком велик.');
			return startSystemJob('restore', {}, RESTORE_INPUT, data);
		}
	},

	resetVpn: {
		call: function() {
			return startSystemJob('reset_vpn', {});
		}
	},

	resetFirstRun: {
		call: function() {
			return startSystemJob('reset_all', {});
		}
	},

	vpnJobStatus: {
		call: function() {
			return vpnJobStatus();
		}
	},

	dashboardStatus: {
		call: function() {
			const uci = cursor();
			const passwall = passwallStatusData();
			const engine = passwall.installed ? 'passwall' : 'openclash';
			return {
				wan: networkStatus(),
				wifi: wifiStatus(uci),
				clients: connectedClients(uci),
				thermal: thermalStatus(),
				active_source: uci.get('oum', 'main', 'active_source') ?? 'none',
				vpn_engine: engine,
				vpn_enabled: engine == 'passwall' ? passwall.enabled : uci.get('openclash', 'config', 'enable') == '1',
				vpn_ready: vpnReady(),
				policy_applying: access('/tmp/oum-device-policy.lock') ? true : false,
				passwall,
				subscription: engine == 'openclash' ? subscriptionStatusData(false) : { available: false, refreshing: false }
			};
		}
	},

	refreshSubscriptionInfo: {
		call: function() {
			const uci = cursor();
			if ((uci.get('oum', 'main', 'active_source') ?? 'none') != 'subscription')
				return failure('not_subscription', 'Сейчас активна не подписка.');
			if (!access('/usr/libexec/oum-subscription-info'))
				return failure('runtime_missing', 'Компонент проверки подписки не установлен.');
			system(`rm -f ${SUBSCRIPTION_CACHE}`);
			subscriptionStatusData(true);
			return { ok: true, message: 'Обновляем данные подписки…' };
		}
	},

	setVpnEnabled: {
		args: { enabled: false },
		call: function(request) {
			if (access(SYSTEM_JOB_LOCK))
				return failure('configuration_busy', 'Дождитесь завершения системной настройки.');
			let enabled = request.args.enabled;
			if (type(enabled) != 'bool')
				return failure('invalid_state', 'Некорректное состояние VPN.');
			const uci = cursor();
			if (passwallInstalled()) {
				let globalSection = null;
				uci.foreach('passwall', 'global', (section) => {
					if (!globalSection)
						globalSection = section['.name'];
				});
				if (!globalSection)
					return failure('passwall_config_missing', 'Не найдена глобальная настройка PassWall.');
				uci.set('passwall', globalSection, 'enabled', enabled ? '1' : '0');
				if (!uci.commit('passwall'))
					return failure('commit_failed', 'Не удалось сохранить состояние PassWall.');
				let action = enabled ? 'restart' : 'stop';
				system(`(/etc/init.d/passwall ${action}) >/tmp/oum-vpn-control.log 2>&1 &`);
				return { ok: true, enabled, engine: 'passwall', message: enabled ? 'PassWall запускается…' : 'PassWall отключается…' };
			}
			if (enabled && (uci.get('oum', 'main', 'active_source') ?? 'none') == 'none')
				return failure('profile_missing', 'Сначала добавьте защищённое подключение.');
			uci.set('openclash', 'config', 'enable', enabled ? '1' : '0');
			if (!uci.commit('openclash'))
				return failure('commit_failed', 'Не удалось сохранить состояние VPN.');
			let action = enabled ? 'restart' : 'stop';
			system(`(/etc/init.d/openclash ${action}) >/tmp/oum-vpn-control.log 2>&1 &`);
			return { ok: true, enabled, message: enabled ? 'VPN запускается…' : 'VPN отключается…' };
		}
	},

	setDevicePolicy: {
		args: { mac: '', policy: 'default' },
		call: function(request) {
			if (access(SYSTEM_JOB_LOCK))
				return failure('configuration_busy', 'Дождитесь завершения системной настройки.');
			let mac = uc(request.args.mac ?? '');
			let policy = request.args.policy ?? 'default';
			if (!match(mac, /^[0-9A-F]{2}(:[0-9A-F]{2}){5}$/))
				return failure('invalid_mac', 'Некорректный MAC-адрес устройства.');
			if (!(policy in [ 'default', 'direct', 'vpn' ]))
				return failure('invalid_policy', 'Неизвестный режим маршрутизации.');

			const uci = cursor();
			let client = filter(connectedClients(uci), (item) => item.mac == mac)[0];
			if (!client)
				return failure('client_offline', 'Устройство должно быть подключено к роутеру.');
			let section = null;
			uci.foreach('oum', 'device', (device) => {
				if (uc(device.mac ?? '') == mac)
					section = device['.name'];
			});
			if (policy == 'default') {
				if (section)
					uci.delete('oum', section);
			}
			else {
				if (!section)
					section = uci.add('oum', 'device');
				uci.set('oum', section, 'mac', mac);
				uci.set('oum', section, 'ip', client.ip);
				uci.set('oum', section, 'name', client.name);
				uci.set('oum', section, 'policy', policy);
			}
			if (!uci.commit('oum'))
				return failure('commit_failed', 'Не удалось сохранить режим устройства.');
			if (system('(/usr/libexec/oum-device-policy apply) >/tmp/oum-device-policy-start.log 2>&1 &') != 0)
				return failure('apply_failed', 'Не удалось применить режим устройства.');
			return { ok: true, mac, policy, message: 'Настройка сохранена и применяется…' };
		}
	},

	nodeStatus: {
		call: function() {
			return nodeStatusData();
		}
	},

	measureNodeDelays: {
		call: function() {
			let current = nodeStatusData();
			if (!current.available)
				return failure('nodes_unavailable', 'Список нод недоступен.');
			if (passwallInstalled()) {
				if (!access('/usr/libexec/oum-passwall-nodes'))
					return failure('runtime_missing', 'Компонент проверки PassWall не установлен.');
				if (configurationBusy())
					return failure('configuration_busy', 'Дождитесь завершения текущей операции.');
				if (system('/usr/libexec/oum-passwall-nodes measure >/tmp/oum-passwall-nodes.log 2>&1') != 0)
					return failure('delay_failed', 'Не удалось измерить задержку нод PassWall.');
				let updated = passwallNodeStatusData();
				let delays = {};
				for (let node in updated.nodes)
					delays[node.name] = node.delay;
				return { ok: true, engine: 'passwall', delays };
			}
			if (system('/usr/libexec/oum-mihomo-api delay >/dev/null 2>&1') != 0)
				return failure('delay_failed', 'Не удалось измерить задержку нод.');
			let updated = nodeStatusData();
			if (!updated.available)
				return failure('delay_read_failed', 'Не удалось прочитать результаты измерения.');
			let delays = {};
			for (let node in updated.nodes)
				delays[node.name] = node.delay;
			return { ok: true, delays };
		}
	},

	selectNode: {
		args: { name: '' },
		call: function(request) {
			let name = request.args.name;
			if (type(name) != 'string' || !length(name) || length(name) > 256)
				return failure('invalid_node', 'Некорректное имя ноды.');
			if (passwallInstalled()) {
				if (!match(name, /^[A-Za-z0-9_]+$/))
					return failure('invalid_node', 'Некорректный идентификатор ноды PassWall.');
				let current = passwallNodeStatusData();
				let selected = filter(current.nodes, (node) => node.id == name)[0];
				if (!current.available || !selected)
					return failure('unknown_node', 'Нода отсутствует в PassWall.');
				if (configurationBusy())
					return failure('configuration_busy', 'Дождитесь завершения текущей операции.');
				if (!access('/usr/libexec/oum-passwall-nodes'))
					return failure('runtime_missing', 'Компонент переключения PassWall не установлен.');
				if (system('mkdir /tmp/oum-passwall-nodes.start') != 0)
					return failure('configuration_busy', 'Другая операция PassWall уже выполняется.');
				if (system(`(/usr/libexec/oum-passwall-nodes switch ${name}) >/tmp/oum-passwall-switch.log 2>&1 &`) != 0) {
					system('rmdir /tmp/oum-passwall-nodes.start');
					return failure('switch_failed', 'Не удалось запустить переключение PassWall.');
				}
				return { ok: true, engine: 'passwall', applying: true, target: name, current: selected.name };
			}
			let current = nodeStatusData();
			if (!current.available || !length(filter(current.nodes, (node) => node.name == name)))
				return failure('unknown_node', 'Нода отсутствует в активной группе.');
			if (!writePrivate('/tmp/oum-mihomo-api/request.json', sprintf('%J', { name })))
				return failure('request_write', 'Не удалось подготовить переключение.');
			if (system('/usr/libexec/oum-mihomo-api switch >/dev/null 2>&1') != 0)
				return failure('switch_failed', 'Mihomo отклонил переключение ноды.');
			let updated = nodeStatusData();
			if (updated.current != name)
				return failure('switch_unconfirmed', 'Mihomo не подтвердил новую ноду.');
			return { ok: true, current: name };
		}
	},

	startVpnImport: {
		args: { vpn_type: '', payload: '' },
		call: function(request) {
			if (access(SYSTEM_JOB_LOCK))
				return failure('configuration_busy', 'Дождитесь завершения системной настройки.');
			let kind = request.args.vpn_type;
			let payload = request.args.payload;
			if (!access('/usr/libexec/oum-source-job'))
				return failure('runtime_missing', 'Компонент импорта OUM не установлен.');
			if (!(kind in [ 'subscription', 'awg', 'proxy' ]))
				return failure('invalid_vpn', 'Неизвестный тип подключения.');
			if (type(payload) != 'string' || length(payload) < 1 || length(payload) > 262144)
				return failure('invalid_payload', 'Конфигурация пустая или слишком большая.');
			if (kind == 'subscription' && (!match(payload, /^https?:\/\//) || match(payload, /\n/)))
				return failure('invalid_url', 'Введите одну ссылку подписки http(s).');
			let current = vpnJobStatus();
			if (current.state == 'running')
				return failure('job_running', 'Импорт уже выполняется.');
			if (system(`rm -rf ${VPN_JOB_DIR} && mkdir -p ${VPN_JOB_DIR} && chmod 700 ${VPN_JOB_DIR}`) != 0)
				return failure('job_directory', 'Не удалось подготовить временное хранилище.');
			if (!writePrivate(`${VPN_JOB_DIR}/input`, payload))
				return failure('input_write', 'Не удалось сохранить временный ввод.');
			if (!writePrivate(`${VPN_JOB_DIR}/status`, 'state=running\ncode=queued\nmessage=Задание поставлено в очередь\n'))
				return failure('status_write', 'Не удалось создать состояние задания.');
			if (system(`(/usr/libexec/oum-source-job ${kind} ${VPN_JOB_DIR}/input) >/dev/null 2>&1 &`) != 0)
				return failure('job_start', 'Не удалось запустить импорт.');
			return { ok: true, state: 'running' };
		}
	},

	applySetup: {
		args: {
			wan_type: 'dhcp',
			pppoe_user: '',
			pppoe_password: '',
			wifi_mode: 'smart',
			ssid_24: '',
			ssid_5: '',
			wifi_password: '',
			admin_password: '',
			vpn_type: 'none'
		},
		call: function(request) {
			if (access(SYSTEM_JOB_LOCK))
				return failure('configuration_busy', 'Дождитесь завершения системной настройки.');
			let phase = 'validation';
			try {
				let check = validate(request.args);
				if (!check.ok)
					return check;

				phase = 'backup';
				if (!backupConfigs())
					return failure('backup_failed', 'Не удалось создать резервную копию настроек.');

				const uci = cursor();
				phase = 'wan';
				configureWan(uci, request.args);
				phase = 'wifi';
				configureWifi(uci, request.args);

				phase = 'state';
				uci.set('oum', 'main', 'wifi_country', 'US');
				uci.set('oum', 'main', 'pending_source', request.args.vpn_type);
				uci.set('oum', 'main', 'setup_step', request.args.vpn_type == 'none' ? 'complete' : 'vpn');
				uci.set('oum', 'main', 'setup_complete', '1');

				phase = 'admin_password';
				if (!setAdminPassword(uci, request.args.admin_password)) {
					restoreConfigs();
					return failure('password_failed', 'Не удалось изменить пароль панели.');
				}
				if (!setRootPassword(request.args.admin_password)) {
					restoreConfigs();
					return failure('root_password_failed', 'Не удалось защитить системную учётную запись.');
				}

				phase = 'commit';
				for (let name in CONFIGS) {
					if (!uci.commit(name)) {
						restoreConfigs();
						return failure('commit_failed', `Не удалось сохранить ${name}. Настройки восстановлены.`);
					}
				}

				system("(sleep 2; /etc/init.d/network reload; /sbin/wifi reload; /etc/init.d/rpcd restart) >/tmp/oum-apply.log 2>&1 &");
				return { ok: true, reconnect: true };
			}
			catch (err) {
				restoreConfigs();
				return failure('internal_error', `Внутренняя ошибка (${phase}): ${err}`);
			}
		}
	}
};

return { oum: methods };
