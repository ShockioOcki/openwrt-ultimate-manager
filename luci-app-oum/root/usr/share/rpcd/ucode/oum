function commandLine(command) {
	let process = popen(command);
	if (!process)
		return '';
	let value = trim(process.read('all') ?? '');
	process.close();
	return value;
}

function podkopJson(command) {
	let allowed = {
		check_dns_available: true,
		check_sing_box: true,
		check_nft_rules: true,
		get_system_info: true,
		outbound_latency: true
	};
	if (!(command in allowed))
		return {};
	let shell = command == 'outbound_latency' ?
		'/usr/bin/podkop clash_api get_proxy_latency main-out 8000 2>/dev/null' :
		`/usr/bin/podkop ${command} 2>/dev/null`;
	let process = popen(shell);
	if (!process)
		return {};
	let value = {};
	try {
		value = json(process) ?? {};
	}
	catch (err) {
		value = {};
	}
	process.close();
	return value;
}

function flag(value) {
	return value == true || +value == 1;
}

function diagnosticSection(id, title, items) {
	let state = 'success';
	for (let item in items) {
		if (item.state == 'error') {
			state = 'error';
			break;
		}
		if (item.state == 'warning')
			state = 'warning';
	}
	return {
		id,
		title,
		state,
		description: state == 'success' ? 'Проверки пройдены' : (state == 'warning' ? 'Обнаружены предупреждения' : 'Обнаружены проблемы'),
		items
	};
}

