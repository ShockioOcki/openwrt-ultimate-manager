function shellquote(value) {
	return `'${replace(value ?? '', "'", "'\\''")}'`;
}

function failure(code, message) {
	return { ok: false, code, message };
}

function writePrivate(path, value) {
	let file = open(path, 'w');
	if (!file)
		return false;
	file.write(value);
	file.close();
	return system(`chmod 600 ${path}`) == 0;
}

function vpnJobStatus() {
	let raw = readfile(`${VPN_JOB_DIR}/status`);
	if (!raw)
		return { state: 'idle', code: '', message: '' };

	let result = { state: 'idle', code: '', message: '' };
	for (let line in split(raw, '\n')) {
		let pair = match(line, /^(state|code|message)=(.*)$/);
		if (pair)
			result[pair[1]] = pair[2];
	}
	if (result.state == 'running' && !access(VPN_JOB_LOCK))
		return { state: 'failed', code: 'interrupted', message: 'Предыдущий импорт был прерван. Его можно запустить заново.' };
	return result;
}

function readKeyValues(path, allowed) {
	let result = {};
	let raw = readfile(path) ?? '';
	for (let line in split(raw, '\n')) {
		let pair = match(line, /^([a-z_]+)=(.*)$/);
		if (pair && pair[1] in allowed)
			result[pair[1]] = pair[2];
	}
	return result;
}

function systemJobStatus() {
	let values = readKeyValues(`${SYSTEM_JOB_DIR}/status`, [ 'state', 'action', 'code', 'message', 'progress', 'total', 'best' ]);
	return {
		state: values.state ?? 'idle',
		action: values.action ?? '',
		code: values.code ?? '',
		message: values.message ?? '',
		progress: +(values.progress ?? 0),
		total: +(values.total ?? 0),
		best: values.best ?? ''
	};
}

function clearSystemJobStatus(action, code) {
	if (access(SYSTEM_JOB_LOCK))
		return failure('configuration_busy', 'Системная операция ещё выполняется.');
	let current = systemJobStatus();
	if (current.state == 'running')
		return failure('configuration_busy', 'Системная операция ещё выполняется.');
	if (length(action ?? '') && current.action != action)
		return failure('status_changed', 'Состояние уже относится к другой операции.');
	if (length(code ?? '') && current.code != code)
		return failure('status_changed', 'Состояние операции уже изменилось.');
	if (system(`rm -f ${SYSTEM_JOB_DIR}/status`) != 0)
		return failure('status_clear_failed', 'Не удалось очистить завершённое уведомление.');
	return { ok: true };
}

function zapretOptions() {
	const uci = cursor();
	let config = null;
	uci.foreach('zapret', 'main', (section) => {
		if (!config && section.NFQWS_OPT != null)
			config = section;
	});
	return config?.NFQWS_OPT ?? '';
}

function zapretStrategyData() {
	let strategies = [];
	for (let index = 1; index <= 27; index++)
		push(strategies, { id: sprintf('Yv%02d', index), label: sprintf('Yv%02d', index) });
	let options = zapretOptions();
	let marker = null;
	for (let line in split(options, '\n')) {
		let candidate = match(line, /^#OUM_YOUTUBE (Yv[0-9][0-9])$/);
		if (candidate) marker = candidate;
	}
	let state = readKeyValues(ZAPRET_STRATEGY_STATE, [ 'catalog_revision', 'current', 'last_mode', 'last_ok', 'last_total', 'last_elapsed_ms', 'last_checked' ]);
	let job = systemJobStatus();
	return {
		available: access('/usr/libexec/oum-zapret-strategy') && access('/etc/init.d/zapret') ? true : false,
		running: system("pgrep -f '^/opt/zapret/nfq/nfqws ' >/dev/null 2>&1") == 0,
		current: marker ? marker[1] : '',
		catalog_revision: state.catalog_revision ?? '189abafd50aed17f8c7414695d0d47d129a6b0dd',
		catalog_total: 27,
		rollback: access('/etc/oum/rollback/zapret-before-strategy') ? true : false,
		last_mode: state.last_mode ?? '',
		last_ok: +(state.last_ok ?? 0),
		last_total: +(state.last_total ?? 0),
		last_elapsed_ms: +(state.last_elapsed_ms ?? 0),
		last_checked: +(state.last_checked ?? 0),
		busy: match(job.action ?? '', /^zapret_/) && job.state == 'running' ? true : false,
		progress: job.progress ?? 0,
		total: job.total ?? 0,
		best: job.best ?? '',
		strategies
	};
}

function configurationBusy() {
	return access(SYSTEM_JOB_LOCK) ||
		access(VPN_JOB_LOCK) ||
		access('/tmp/oum-device-policy.lock') || access('/tmp/oum-passwall-nodes.lock') ||
		access('/tmp/oum-passwall-nodes.start') ||
		vpnJobStatus().state == 'running';
}

function startSystemJob(action, payload, inputPath, inputData) {
	if (!access('/usr/libexec/oum-system-job'))
		return failure('runtime_missing', 'Компонент системных настроек не установлен.');
	if (configurationBusy())
		return failure('configuration_busy', 'Дождитесь завершения текущей операции.');
	if (system(`mkdir ${SYSTEM_JOB_LOCK}`) != 0)
		return failure('configuration_busy', 'Другая операция уже выполняется.');
	if (system(`rm -rf ${SYSTEM_JOB_DIR} && mkdir -p ${SYSTEM_JOB_DIR} && chmod 700 ${SYSTEM_JOB_DIR}`) != 0 ||
		!writePrivate(`${SYSTEM_JOB_DIR}/request.json`, sprintf('%J', payload ?? {})) ||
		(length(inputPath ?? '') && !writePrivate(inputPath, inputData ?? '')) ||
		!writePrivate(`${SYSTEM_JOB_DIR}/status`, `state=running\naction=${action}\ncode=queued\nmessage=Операция поставлена в очередь.\n`)) {
		system(`rm -rf ${SYSTEM_JOB_DIR}; rmdir ${SYSTEM_JOB_LOCK}`);
		if (length(inputPath ?? ''))
			system(`rm -f ${inputPath}`);
		return failure('job_prepare', 'Не удалось подготовить операцию.');
	}
	if (system(`(/usr/libexec/oum-system-job ${action}) >/tmp/oum-system-job.log 2>&1 &`) != 0) {
		system(`rmdir ${SYSTEM_JOB_LOCK}`);
		if (length(inputPath ?? ''))
			system(`rm -f ${inputPath}`);
		return failure('job_start', 'Не удалось запустить операцию.');
	}
	return { ok: true, state: 'running', action };
}

function wirelessStations() {
	let stations = {};
	let bus = connect();
	let process = popen("/bin/ubus list 'hostapd.*' 2>/dev/null");
	if (!process)
		return stations;
	for (let line = process.read('line'); length(line); line = process.read('line')) {
		let object = trim(line);
		if (!match(object, /^hostapd\.[A-Za-z0-9_.-]+$/))
			continue;
		let status = bus?.call(object, 'get_clients') ?? {};
		for (let mac in (status.clients ?? {})) {
			if (match(mac, /^[0-9A-Fa-f:]{17}$/))
				stations[uc(mac)] = true;
		}
	}
	process.close();
	return stations;
}

function connectedClients(uci) {
	let clients = {};
	let stations = wirelessStations();
	let policies = {};
	let savedNames = {};
	let lanValue = uci.get('network', 'lan', 'ipaddr') ?? '';
	let lanAddress = replace(type(lanValue) == 'array' ? (lanValue[0] ?? '') : lanValue, /\/.*/, '');
	let lanPrefix = replace(lanAddress, /\.[0-9]+$/, '.');
	let lanDevice = uci.get('network', 'lan', 'device') ?? 'br-lan';
	uci.foreach('oum', 'device', (device) => {
		if (match(device.mac ?? '', /^[0-9A-Fa-f:]{17}$/)) {
			let mac = uc(device.mac);
			policies[mac] = device.policy ?? 'default';
			if (length(device.name ?? '')) savedNames[mac] = device.name;
		}
	});
	let leases = readfile('/tmp/dhcp.leases') ?? '';
	for (let line in split(leases, '\n')) {
		let fields = match(line, /^(\d+)\s+([0-9A-Fa-f:]{17})\s+(\S+)\s+(\S+)/);
		if (!fields)
			continue;
		let mac = uc(fields[2]);
		clients[mac] = {
			name: fields[4] == '*' ? (savedNames[mac] ?? '') : fields[4],
			mac,
			ip: fields[3],
			medium: stations[mac] ? 'wifi' : 'unknown',
			expires: +fields[1],
			policy: policies[mac] ?? 'default',
			seen: stations[mac] ? true : false
		};
	}
	let process = popen('/sbin/ip -4 neigh show 2>/dev/null');
	if (process) {
		for (let line = process.read('line'); length(line); line = process.read('line')) {
			let fields = match(line, /^(\d+\.\d+\.\d+\.\d+)\s+dev\s+(\S+).*\slladdr\s+([0-9A-Fa-f:]{17}).*\s(REACHABLE|STALE|DELAY|PROBE|PERMANENT|NOARP)\s*$/);
			if (!fields) continue;
			if (fields[2] != lanDevice) continue;
			if (length(lanPrefix) && substr(fields[1], 0, length(lanPrefix)) != lanPrefix) continue;
			let mac = uc(fields[3]);
			let current = clients[mac] ?? {};
			clients[mac] = {
				name: current.name ?? savedNames[mac] ?? '',
				mac,
				ip: fields[1],
				medium: stations[mac] ? 'wifi' : 'ethernet',
				expires: current.expires ?? 0,
				policy: policies[mac] ?? 'default',
				seen: true
			};
		}
		process.close();
	}
	let result = [];
	for (let mac, client in clients) {
		if (!client.seen)
			continue;
		if (!length(client.name ?? '')) client.name = `Устройство ${substr(mac, 9)}`;
		push(result, {
			name: client.name,
			mac: client.mac,
			ip: client.ip,
			medium: client.medium,
			expires: client.expires,
			policy: client.policy,
			seen: client.seen
		});
	}
	return sort(result, (a, b) => a.name < b.name ? -1 : (a.name > b.name ? 1 : 0));
}

function thermalStatus() {
	let sensors = [];
	let maximum = null;
	for (let path in glob('/sys/class/thermal/thermal_zone*/temp')) {
		let directory = dirname(path);
		let raw = +trim(readfile(path) ?? '0');
		if (!raw)
			continue;
		let value = raw > 1000 ? raw / 1000 : raw;
		let name = trim(readfile(`${directory}/type`) ?? basename(directory));
		push(sensors, { name, value });
		if (maximum == null || value > maximum)
			maximum = value;
	}
	return { maximum, sensors };
}

function wifiStatus(uci) {
	let networks = [];
	uci.foreach('wireless', 'wifi-iface', (iface) => {
		if (iface.mode == 'ap' && iface.disabled != '1' && length(iface.ssid ?? ''))
			push(networks, { ssid: iface.ssid, device: iface.device ?? '' });
	});
	return networks;
}

function podkopInstalled() {
	return access('/etc/init.d/podkop') && access('/etc/config/podkop') && access('/etc/init.d/zapret');
}

function unmanagedTunnels(uci) {
	let result = [];
	let bus = connect();
	uci.foreach('network', 'interface', (section) => {
		let proto = section.proto ?? '';
		let name = section['.name'] ?? '';
		if (!(proto in [ 'amneziawg', 'wireguard' ]) || !match(name, /^[A-Za-z0-9_]+$/))
			return;
		if (podkopInstalled() && (uci.get('podkop', 'main', 'interface') ?? '') == name)
			return;
		let state = bus?.call(`network.interface.${name}`, 'status') ?? {};
		push(result, { name, proto, up: state.up == true });
	});
	return result;
}

function networkStatus() {
	let result = { up: false, ipv4: '', device: '', proto: '' };
	let bus = connect();
	let status = bus?.call('network.interface.wan', 'status');
	if (!status)
		return result;
	result.up = status.up == true;
	result.device = status.l3_device ?? status.device ?? '';
	result.proto = status.proto ?? '';
	result.ipv4 = status['ipv4-address']?.[0]?.address ?? '';
	return result;
}

function capabilityStatus() {
	let usbNetwork = system("for path in /sys/class/net/*/device; do target=$(readlink -f \"$path\") || continue; case \"$target\" in */usb*/*) exit 0;; esac; done; exit 1") == 0;
	let mobileControl = length(glob('/dev/cdc-wdm*')) > 0 || length(glob('/dev/ttyUSB*')) > 0;
	return {
		mesh_driver: system("iw list 2>/dev/null | grep -q 'mesh point'") == 0,
		mesh_runtime: system("apk info 2>/dev/null | grep -Eq '^wpad($|-(mesh-)?(mbedtls|openssl|wolfssl)$)'") == 0,
		mesh_runtime_bundle: system("/usr/libexec/oum-mesh-runtime status >/dev/null 2>&1") == 0,
		usb_host: length(glob('/sys/bus/usb/devices/usb*')) > 0,
		usb_storage: length(glob('/sys/class/block/sd*')) > 0,
		usb_network: usbNetwork,
		usb_modem: mobileControl
	};
}

function passwallInstalled() {
