
config theme 'settings'
	option mode 'light'
	option accent 'custom'
	option accent_custom '#1867dc'
	option zoom '105'
	option transparency '1'
	option border_radius 'default'
	option tab_outline '0'
	option tab_style 'modern'
	option animations '1'
	option services_widget '1'
	option temp_widget '1'
	option metrics_widget '1'
	option throughput_widget '1'
	option services_log '0'
	option log_highlight '1'
	option page_width '55'
	option menu_mode 'top'
	option menu_collapsed '0'
	option background_pattern 'none'
	option pattern_scale '100'
	option custom_font '0'
	option login_animation 'particles'
	option login_branding '1'
	option login_logo_only '0'
	option login_name 'OUM'
