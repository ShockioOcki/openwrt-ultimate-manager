#!/bin/sh

set -eu
umask 077

ACTION="${1:-}"
JOB_DIR=/tmp/oum-system-job
LOCK_DIR=/tmp/oum-system-job.lock
REQUEST="$JOB_DIR/request.json"
STATUS="$JOB_DIR/status"
ROLLBACK=/etc/oum/rollback

[ -d "$LOCK_DIR" ] || exit 3

write_status() {
	state="$1"
	code="$2"
	message="$3"
	tmp="$STATUS.tmp"
	printf 'state=%s\naction=%s\ncode=%s\nmessage=%s\n' "$state" "$ACTION" "$code" "$message" > "$tmp"
	mv "$tmp" "$STATUS"
}

cleanup() {
	rm -f "$REQUEST"
	rmdir "$LOCK_DIR" 2>/dev/null || true
}
trap cleanup EXIT
trap 'write_status failed interrupted "Операция остановлена."; exit 130' INT TERM

fail() {
	write_status failed "$1" "$2"
	exit 1
}

json_value() {
	jsonfilter -i "$REQUEST" -e "@$1"
}

apply_wifi() {
	mode="$(json_value .wifi_mode)"
	ssid24="$(json_value .ssid_24)"
	ssid5="$(json_value .ssid_5)"
	password="$(json_value .wifi_password)"
	[ "$mode" = smart ] || [ "$mode" = separate ] || fail invalid_input 'Некорректный режим Wi-Fi.'
	[ -n "$ssid24" ] || fail invalid_input 'Имя Wi-Fi не задано.'
	[ "$mode" != separate ] || [ -n "$ssid5" ] || fail invalid_input 'Имя сети 5 ГГц не задано.'
	mkdir -p "$ROLLBACK"
	cp /etc/config/wireless "$ROLLBACK/wireless"
	chmod 600 "$ROLLBACK/wireless"
	for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
		uci -q set "wireless.$radio.country=US"
	done
	for section in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get "wireless.$section.mode")" = ap ] || continue
		device="$(uci -q get "wireless.$section.device")"
		band="$(uci -q get "wireless.$device.band")"
		ssid="$ssid24"
		[ "$mode" != separate ] || [ "$band" != 5g ] || ssid="$ssid5"
		uci -q set "wireless.$section.ssid=$ssid"
		uci -q set "wireless.$section.encryption=sae-mixed"
		uci -q set "wireless.$section.disabled=0"
		[ -z "$password" ] || uci -q set "wireless.$section.key=$password"
	done
	uci -q commit wireless || fail commit_failed 'Не удалось сохранить Wi-Fi.'
	if ! wifi reload >/dev/null 2>&1; then
		cp "$ROLLBACK/wireless" /etc/config/wireless
		wifi reload >/dev/null 2>&1 || true
		fail reload_failed 'Wi-Fi не перезапустился; предыдущие настройки восстановлены.'
	fi
	write_status success applied 'Настройки Wi-Fi применены. Подключитесь к сети заново, если её имя изменилось.'
}

apply_wan() {
	wan_type="$(json_value .wan_type)"
	username="$(json_value .pppoe_user)"
	password="$(json_value .pppoe_password)"
	[ "$wan_type" = dhcp ] || [ "$wan_type" = pppoe ] || fail invalid_input 'Некорректный тип подключения.'
	[ "$wan_type" != pppoe ] || [ -n "$username" ] || fail invalid_input 'Логин PPPoE не задан.'
	mkdir -p "$ROLLBACK"
	cp /etc/config/network "$ROLLBACK/network"
	chmod 600 "$ROLLBACK/network"
	uci -q set "network.wan.proto=$wan_type"
	if [ "$wan_type" = pppoe ]; then
		uci -q set "network.wan.username=$username"
		[ -z "$password" ] || uci -q set "network.wan.password=$password"
	else
		uci -q delete network.wan.username || true
		uci -q delete network.wan.password || true
	fi
	uci -q commit network || fail commit_failed 'Не удалось сохранить подключение.'
	if ! /etc/init.d/network reload >/dev/null 2>&1; then
		cp "$ROLLBACK/network" /etc/config/network
		/etc/init.d/network reload >/dev/null 2>&1 || true
		fail reload_failed 'Сеть не перезапустилась; предыдущие настройки восстановлены.'
	fi
	write_status success applied 'Настройки WAN применены. Проверяем подключение…'
}

apply_lan() {
	address="$(json_value .address)"
	case "$address" in ''|*[!0-9.]*) fail invalid_input 'Некорректный LAN-адрес.' ;; esac
	mkdir -p "$ROLLBACK"
	cp /etc/config/network "$ROLLBACK/network-lan"
	uci -q get network.lan.ipaddr | sed 's#/.*##' > "$ROLLBACK/lan-address"
	chmod 600 "$ROLLBACK/network-lan" "$ROLLBACK/lan-address"
	uci -q set "network.lan.ipaddr=$address"
	uci -q set network.lan.netmask='255.255.255.0'
	uci -q commit network || fail commit_failed 'Не удалось сохранить LAN-адрес.'
	write_status success applied "LAN-адрес изменён на $address/24. Переподключитесь к роутеру."
	(sleep 3; /etc/init.d/network reload) >/tmp/oum-lan-apply.log 2>&1 &
}

apply_mesh() {
	enabled="$(json_value .enabled)"
	mesh_id="$(json_value .mesh_id)"
	password="$(json_value .password)"
	band="$(json_value .band)"
	if [ "$enabled" = 1 ]; then
		/usr/libexec/oum-mesh-manager enable "$mesh_id" "$password" "$band" ||
			fail mesh_failed 'Mesh не запустился; предыдущая Wi-Fi-конфигурация восстановлена.'
		write_status success applied 'Mesh-интерфейс создан и подключён к LAN.'
	else
		/usr/libexec/oum-mesh-manager disable || fail mesh_failed 'Не удалось отключить Mesh.'
		write_status success applied 'Mesh-интерфейс отключён.'
	fi
}

rollback_lan() {
	[ -f "$ROLLBACK/network-lan" ] || fail rollback_missing 'Предыдущая LAN-конфигурация не найдена.'
	previous="$(cat "$ROLLBACK/lan-address" 2>/dev/null || true)"
	cp "$ROLLBACK/network-lan" /etc/config/network
	write_status success rolled_back "Предыдущий LAN-адрес ${previous:-роутера} восстановлен."
	(sleep 3; /etc/init.d/network reload) >/tmp/oum-lan-rollback.log 2>&1 &
}

rollback_config() {
	kind="$1"
	[ -f "$ROLLBACK/$kind" ] || fail rollback_missing 'Предыдущая конфигурация не найдена.'
	cp "$ROLLBACK/$kind" "/etc/config/$kind"
	if [ "$kind" = wireless ]; then wifi reload >/dev/null 2>&1; else /etc/init.d/network reload >/dev/null 2>&1; fi
	write_status success rolled_back 'Предыдущие настройки восстановлены.'
}

apply_dns() {
	openclash="$(json_value .openclash)"
	bootstrap_openclash="$(json_value .bootstrap_openclash)"
	passwall="$(json_value .passwall)"
	bootstrap_passwall="$(json_value .bootstrap_passwall)"
	podkop="$(json_value .podkop)"
	bootstrap_podkop="$(json_value .bootstrap_podkop)"
	engine="$(/usr/libexec/oum-engine-manager current)"
	case "$engine" in
		openclash) server="$openclash"; bootstrap="$bootstrap_openclash" ;;
		passwall) server="$passwall"; bootstrap="$bootstrap_passwall" ;;
		podkop) server="$podkop"; bootstrap="$bootstrap_podkop" ;;
		*) fail engine_missing 'Сначала установите VPN-движок.' ;;
	esac
	write_status running dns 'Применяем основной и Bootstrap DNS выбранного VPN-движка…'
	/usr/libexec/oum-dns-manager apply "$engine" "$server" "$bootstrap" ||
		fail dns_failed 'DNS не прошёл проверку; предыдущая конфигурация восстановлена.'
	uci -q set "oum.main.dns_openclash=$openclash"
	uci -q set "oum.main.bootstrap_dns_openclash=$bootstrap_openclash"
	uci -q set "oum.main.dns_passwall=$passwall"
	uci -q set "oum.main.bootstrap_dns_passwall=$bootstrap_passwall"
	uci -q set "oum.main.dns_podkop=$podkop"
	uci -q set "oum.main.bootstrap_dns_podkop=$bootstrap_podkop"
	uci -q commit oum
	write_status success applied 'Основной и Bootstrap DNS сохранены; активный VPN-движок перезапущен.'
}

case "$ACTION" in
	wifi) write_status running applying 'Применяем настройки Wi-Fi…'; apply_wifi ;;
	wan) write_status running applying 'Применяем настройки подключения…'; apply_wan ;;
	lan) write_status running applying 'Сохраняем новый LAN-адрес…'; apply_lan ;;
	mesh) write_status running applying 'Проверяем и применяем Mesh…'; apply_mesh ;;
	mesh_runtime) write_status running installing 'Устанавливаем совместимую поддержку Mesh…'; /usr/libexec/oum-mesh-runtime install || fail mesh_runtime_failed 'Mesh-компонент не установился; исходный Wi-Fi восстановлен.'; write_status success installed 'Mesh готов. Wi-Fi перезапущен, обычные точки доступа сохранены.' ;;
	project_update) write_status running downloading 'Загружаем и проверяем новую версию OUM…'; /usr/libexec/oum-project-manager update || fail update_failed 'Обновление OUM не установилось; текущая версия сохранена.'; write_status success updated 'OUM обновлён. Интерфейс перезагружается.' ;;
	project_rollback) write_status running rollback 'Восстанавливаем предыдущую версию OUM…'; /usr/libexec/oum-project-manager rollback || fail rollback_failed 'Не удалось восстановить предыдущую версию OUM.'; write_status success rolled_back 'Предыдущая версия OUM восстановлена.' ;;
	rollback_wifi) write_status running rollback 'Восстанавливаем Wi-Fi…'; rollback_config wireless ;;
	rollback_wan) write_status running rollback 'Восстанавливаем подключение…'; rollback_config network ;;
	rollback_lan) write_status running rollback 'Восстанавливаем LAN-адрес…'; rollback_lan ;;
	dns) apply_dns ;;
	engine) target="$(json_value .engine)"; [ "$target" != podkop ] || /usr/libexec/oum-awg-manager ready || fail reboot_required 'После первичной установки OUM один раз перезапустите роутер для активации AmneziaWG.'; write_status running preparing 'Проверяем прямой доступ и выполняем чистую замену VPN-движка…'; if ! OUM_ENGINE_STATUS="$STATUS" /usr/libexec/oum-engine-manager switch "$target"; then message="$(cat /tmp/oum-engine-error 2>/dev/null || true)"; fail engine_failed "${message:-Не удалось выполнить чистую установку VPN-движка.}"; fi; write_status success switched 'Новый VPN-движок установлен без старых настроек. Добавьте подключение ниже.' ;;
	podkop_configure) interface="$(json_value .interface)"; write_status running configuring 'Связываем Podkop с отдельным туннелем и настраиваем Zapret для YouTube…'; /usr/libexec/oum-podkop-config configure "$interface" || fail podkop_failed 'Podkop не прошёл проверку; службы остановлены, прежняя конфигурация сохранена.'; write_status success configured 'Podkop работает через отдельный туннель; Zapret для прямого YouTube завершает запуск.' ;;
	podkop_awg) write_status running awg_installing 'Проверяем комплект AmneziaWG и создаём отдельный туннель…'; /usr/libexec/oum-awg-manager import "$REQUEST" || fail awg_failed 'AWG-туннель не прошёл проверку; прежняя сеть восстановлена.'; write_status success configured 'AWG-туннель создан и Podkop запущен через него.' ;;
	podkop_proxy) write_status running proxy_configuring 'Проверяем Reality и создаём защищённое подключение Podkop…'; /usr/libexec/oum-podkop-config proxy "$REQUEST" || fail podkop_proxy_failed 'Reality не прошёл проверку; предыдущее подключение восстановлено.'; write_status success configured 'Reality проверен и используется Podkop.' ;;
	podkop_routing) write_status running routing 'Проверяем списки и перестраиваем маршрутизацию Podkop…'; /usr/libexec/oum-podkop-config routing "$REQUEST" || fail podkop_routing_failed 'Новые правила не прошли проверку; прежняя маршрутизация восстановлена.'; write_status success routed 'Маршрутизация Podkop сохранена и проверена.' ;;
	podkop_youtube) mode="$(json_value .mode)"; write_status running youtube 'Переключаем маршрут YouTube и проверяем сервисы…'; OUM_JOB_STATUS="$STATUS" OUM_JOB_ACTION="$ACTION" /usr/libexec/oum-podkop-config youtube "$REQUEST" || fail podkop_youtube_failed 'Новый режим YouTube не прошёл проверку; предыдущий восстановлен.'; write_status success configured "$([ "$mode" = vpn ] && echo 'YouTube направлен через защищённое подключение; Zapret остановлен.' || echo 'YouTube идёт напрямую и обрабатывается Zapret.')" ;;
	zapret_quic) enabled="$(json_value .enabled)"; write_status running quic 'Изменяем глобальный режим QUIC…'; /usr/libexec/oum-zapret-quic "$([ "$enabled" = 1 ] && echo enable || echo disable)" || fail zapret_quic_failed 'Не удалось изменить режим QUIC; предыдущий firewall восстановлен.'; write_status success configured "$([ "$enabled" = 1 ] && echo 'QUIC заблокирован: клиенты будут использовать TCP/TLS.' || echo 'QUIC снова разрешён.')" ;;
	zapret_manager_install) write_status running downloading 'Загружаем и проверяем закреплённый Zapret Manager…'; /usr/libexec/oum-zapret-manager install || fail zapret_manager_failed 'Не удалось подготовить Zapret Manager или не совпала контрольная сумма.'; write_status success installed 'Zapret Manager подготовлен. Запускайте командой oum-zapret-manager из root SSH.' ;;
	zapret_auto) write_status running testing 'Готовим автоматический подбор стратегии Zapret…'; OUM_JOB_STATUS="$STATUS" OUM_JOB_ACTION="$ACTION" /usr/libexec/oum-zapret-strategy auto || fail zapret_test_failed 'Рабочая стратегия не найдена; предыдущая конфигурация восстановлена.'; write_status success applied 'Лучшая стратегия YouTube выбрана, проверена и применена.' ;;
	zapret_apply) strategy="$(json_value .strategy)"; write_status running applying "Применяем стратегию $strategy…"; OUM_JOB_STATUS="$STATUS" OUM_JOB_ACTION="$ACTION" /usr/libexec/oum-zapret-strategy apply "$strategy" || fail zapret_apply_failed 'Стратегия не прошла проверку; предыдущая конфигурация восстановлена.'; write_status success applied "Стратегия $strategy применена." ;;
	zapret_check) write_status running testing 'Проверяем текущую стратегию Zapret…'; OUM_JOB_STATUS="$STATUS" OUM_JOB_ACTION="$ACTION" /usr/libexec/oum-zapret-strategy check || fail zapret_check_failed 'Текущая стратегия не прошла проверку.'; write_status success checked 'Текущая стратегия Zapret прошла проверку.' ;;
	zapret_restore) write_status running rollback 'Возвращаем предыдущую стратегию Zapret…'; /usr/libexec/oum-zapret-strategy restore || fail zapret_restore_failed 'Не удалось вернуть предыдущую стратегию.'; write_status success restored 'Предыдущая стратегия Zapret восстановлена.' ;;
	restore) write_status running restoring 'Проверяем и восстанавливаем резервную копию…'; /usr/libexec/oum-backup restore || fail restore_failed 'Резервная копия отклонена; текущие настройки сохранены.'; write_status success restored 'Резервная копия восстановлена.' ;;
	reset_vpn) write_status running resetting 'Удаляем настройки VPN…'; /usr/libexec/oum-reset-vpn || fail reset_failed 'Не удалось сбросить VPN.'; write_status success reset 'VPN сброшен. Можно добавить новый источник.' ;;
	reset_all) write_status running resetting 'Возвращаем мастер первого запуска…'; /usr/libexec/oum-reset-first-run || fail reset_failed 'Не удалось вернуть мастер первого запуска.'; write_status success reset 'Мастер первого запуска восстановлен.' ;;
	*) fail invalid_action 'Неизвестная системная операция.' ;;
esac
