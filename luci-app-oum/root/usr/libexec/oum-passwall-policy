#!/bin/sh

set -e

PASSWALL_BACKUP=/tmp/oum-passwall-policy.passwall
DHCP_BACKUP=/tmp/oum-passwall-policy.dhcp
OUM_BACKUP=/tmp/oum-passwall-policy.oum
PASSWALL_LOG=/tmp/oum-passwall-policy.log

IPKG_INSTROOT="${IPKG_INSTROOT:-}"
export IPKG_INSTROOT
. /lib/functions.sh

valid_mac() {
	printf '%s' "$1" | grep -Eq '^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$'
}

valid_ipv4() {
	printf '%s' "$1" | awk -F. '
		NF != 4 { exit 1 }
		{ for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit 1 }
	'
}

contains_word() {
	case " $1 " in
		*" $2 "*) return 0 ;;
	esac
	return 1
}

without_words() {
	local current="$1" removed="$2" word result=''
	for word in $current; do
		contains_word "$removed" "$word" && continue
		contains_word "$result" "$word" || result="${result:+$result }$word"
	done
	printf '%s' "$result"
}

append_word() {
	local current="$1" word="$2"
	if contains_word "$current" "$word"; then
		printf '%s' "$current"
	else
		printf '%s' "${current:+$current }$word"
	fi
}

# Device overrides use independent ACLs; the global node may be a selective
# shunt. Sources are a single space-joined string, not UCI list entries.
ACL_REMARKS='OUM device direct'
GAME_ACL_REMARKS='OUM gaming direct'
VPN_ACL_REMARKS='OUM device VPN'
GAME_TCP_PORTS='3074,3478-3480,5222-5223,27014-27050'
GAME_UDP_PORTS='88,500,3074,3478-3479,3544,3658,4379-4380,4500,27000-27200'

find_oum_acl() {
	local remarks="$1" line sec
	uci -q show passwall 2>/dev/null | while IFS= read -r line; do
		case "$line" in
			*=acl_rule) sec="${line%%=*}"; sec="${sec##*.}" ;;
			*) continue ;;
		esac
		[ "$(uci -q get "passwall.$sec.remarks")" = "$remarks" ] && { printf '%s' "$sec"; return 0; }
	done
	return 1
}
cp /etc/config/passwall "$PASSWALL_BACKUP"
cp /etc/config/dhcp "$DHCP_BACKUP"
cp /etc/config/oum "$OUM_BACKUP"
chmod 600 "$PASSWALL_BACKUP" "$DHCP_BACKUP" "$OUM_BACKUP"

vpn_ips=''
vpn_macs=''
direct_ips=''
gaming_ips=''

for section in $(uci -q show dhcp | sed -n "s/^dhcp\.\(oum_[A-Za-z0-9_]*\)=host$/\1/p"); do
	uci -q delete "dhcp.$section" || true
done

apply_device() {
	local section="$1" mac ip name policy id
	config_get mac "$section" mac ''
	config_get ip "$section" ip ''
	config_get name "$section" name 'device'
	config_get policy "$section" policy 'default'
	valid_mac "$mac" || return 0
	valid_ipv4 "$ip" || return 0
	id="$(printf '%s' "$mac" | tr -d ':' | tr 'A-F' 'a-f')"

	case "$policy" in
		direct)
			direct_ips="$(append_word "$direct_ips" "$ip")"
			;;
		gaming)
			gaming_ips="$(append_word "$gaming_ips" "$ip")"
			;;
		vpn)
			vpn_ips="$(append_word "$vpn_ips" "$ip")"
			vpn_macs="$(append_word "$vpn_macs" "$mac")"
			;;
		*) return 0 ;;
	esac

	uci -q set "dhcp.oum_$id=host"
	uci -q set "dhcp.oum_$id.mac=$mac"
	uci -q set "dhcp.oum_$id.ip=$ip"
	uci -q set "dhcp.oum_$id.name=$name"
}

config_load oum
config_foreach apply_device device

if [ -n "$direct_ips" ]; then
	uci -q set "oum.main.managed_passwall_direct_ips=$direct_ips"
else
	uci -q delete oum.main.managed_passwall_direct_ips || true
fi
if [ -n "$vpn_ips" ]; then
	uci -q set "oum.main.managed_passwall_vpn_ips=$vpn_ips"
else
	uci -q delete oum.main.managed_passwall_vpn_ips || true
fi
if [ -n "$gaming_ips" ]; then
	uci -q set "oum.main.managed_passwall_gaming_ips=$gaming_ips"
else
	uci -q delete oum.main.managed_passwall_gaming_ips || true
fi

uci -q commit dhcp
uci -q commit oum
# Legacy key from the short-lived shunt-based attempt (2026-09-07): drop it.
uci -q delete oum.main.bypass_direct_ips 2>/dev/null || true
uci commit oum 2>/dev/null || true
# Sync the OUM acl_rule (anonymous, remarks marker) with direct-policy IPs.
# Sources must be BARE IPs (no `ip:` prefix — acl_app adds it itself;
# only `ipset:` keeps a prefix). Single space-joined string via `uci set`.
# Acls must be anonymous: passwall's gate matches @acl_rule only.
acl_sources=''
for ip in $direct_ips; do
	acl_sources="${acl_sources:+$acl_sources }$ip"
done
acl_sec="$(find_oum_acl "$ACL_REMARKS" || true)"
if [ -n "$acl_sources" ]; then
	if [ -z "$acl_sec" ]; then
		acl_sec="$(uci add passwall acl_rule)" || {
			cp "$PASSWALL_BACKUP" /etc/config/passwall
			cp "$DHCP_BACKUP" /etc/config/dhcp
			cp "$OUM_BACKUP" /etc/config/oum
			chmod 600 /etc/config/passwall /etc/config/dhcp /etc/config/oum
			printf '%s\n' 'Cannot create passwall acl_rule.' > "$PASSWALL_LOG"
			rm -f "$PASSWALL_BACKUP" "$DHCP_BACKUP" "$OUM_BACKUP"
			exit 1
		}
	fi
	uci -q set "passwall.$acl_sec.enabled=1"
	uci -q set "passwall.$acl_sec.remarks=$ACL_REMARKS"
	uci -q set "passwall.$acl_sec.sources=$acl_sources"
	uci -q set "passwall.$acl_sec.tcp_no_redir_ports=1-65535"
	uci -q set "passwall.$acl_sec.udp_no_redir_ports=1-65535"
	uci -q set "passwall.@global[0].acl_enable=1"
	uci commit passwall
else
	if [ -n "$acl_sec" ]; then
		uci -q delete "passwall.$acl_sec"
		uci commit passwall
	fi
fi

# A gaming device keeps normal OUM routing for web traffic, while common
# Steam/console transport ports bypass the transparent proxy. Domain-based
# game routing is owned by oum_games in the shunt profile.
game_acl_sec="$(find_oum_acl "$GAME_ACL_REMARKS" || true)"
if [ -n "$gaming_ips" ]; then
	if [ -z "$game_acl_sec" ]; then
		game_acl_sec="$(uci add passwall acl_rule)" || {
			cp "$PASSWALL_BACKUP" /etc/config/passwall
			cp "$DHCP_BACKUP" /etc/config/dhcp
			cp "$OUM_BACKUP" /etc/config/oum
			chmod 600 /etc/config/passwall /etc/config/dhcp /etc/config/oum
			printf '%s\n' 'Cannot create passwall gaming acl_rule.' > "$PASSWALL_LOG"
			rm -f "$PASSWALL_BACKUP" "$DHCP_BACKUP" "$OUM_BACKUP"
			exit 1
		}
	fi
	uci -q set "passwall.$game_acl_sec.enabled=1"
	uci -q set "passwall.$game_acl_sec.remarks=$GAME_ACL_REMARKS"
	uci -q set "passwall.$game_acl_sec.sources=$gaming_ips"
	uci -q set "passwall.$game_acl_sec.use_global_config=1"
	uci -q set "passwall.$game_acl_sec.tcp_no_redir_ports=$GAME_TCP_PORTS"
	uci -q set "passwall.$game_acl_sec.udp_no_redir_ports=$GAME_UDP_PORTS"
	uci -q set passwall.@global[0].acl_enable=1
	uci commit passwall
elif [ -n "$game_acl_sec" ]; then
	uci -q delete "passwall.$game_acl_sec"
	uci commit passwall
fi
# Full-device VPN bypasses the global selective shunt. MAC matching also
# covers IPv6 and survives address changes. Keep LAN destinations local.
vpn_acl_sec="$(find_oum_acl "$VPN_ACL_REMARKS" || true)"
if [ -n "$vpn_ips" ]; then
	vpn_node="$(uci -q get passwall.@global[0].tcp_node)"
	if [ "$(uci -q get "passwall.$vpn_node.protocol")" = _shunt ]; then
		vpn_node="$(uci -q get "passwall.$vpn_node.default_node")"
	fi
	[ "$(uci -q get "passwall.$vpn_node")" = nodes ] || exit 1
	[ -n "$vpn_acl_sec" ] || vpn_acl_sec="$(uci add passwall acl_rule)"
	for option in use_global_config use_direct_list use_proxy_list use_block_list use_gfw_list; do
		uci -q set "passwall.$vpn_acl_sec.$option=0"
	done
	uci -q set "passwall.$vpn_acl_sec.enabled=1"
	uci -q set "passwall.$vpn_acl_sec.remarks=$VPN_ACL_REMARKS"
	uci -q set "passwall.$vpn_acl_sec.sources=$vpn_macs"
	uci -q set "passwall.$vpn_acl_sec.tcp_node=$vpn_node"
	uci -q set "passwall.$vpn_acl_sec.udp_node=tcp"
	uci -q set "passwall.$vpn_acl_sec.chn_list=0"
	for protocol in tcp udp; do
		uci -q set "passwall.$vpn_acl_sec.${protocol}_proxy_mode=proxy"
		uci -q set "passwall.$vpn_acl_sec.${protocol}_no_redir_ports=disable"
		uci -q set "passwall.$vpn_acl_sec.${protocol}_proxy_drop_ports=disable"
		uci -q set "passwall.$vpn_acl_sec.${protocol}_redir_ports=1-65535"
	done
	uci -q set "passwall.$vpn_acl_sec.dns_shunt=dnsmasq"
	uci -q set "passwall.$vpn_acl_sec.dns_mode=xray"
	uci -q set "passwall.$vpn_acl_sec.v2ray_dns_mode=tcp"
	uci -q set "passwall.$vpn_acl_sec.remote_dns=$(uci -q get passwall.@global[0].remote_dns)"
	uci -q set "passwall.$vpn_acl_sec.use_default_dns=remote"
	uci -q set "passwall.$vpn_acl_sec.filter_proxy_ipv6=0"
	uci -q set passwall.@global[0].acl_enable=1
	# Enable the IPv6 interception hook so MAC ACLs cannot silently leak IPv6.
	if ! uci -q get oum.main.passwall_policy_previous_ipv6 >/dev/null; then
		uci -q set "oum.main.passwall_policy_previous_ipv6=$(uci -q get passwall.@global_forwarding[0].ipv6_tproxy || echo 0)"
	fi
	uci -q set passwall.@global_forwarding[0].ipv6_tproxy=1
else
	[ -z "$vpn_acl_sec" ] || uci -q delete "passwall.$vpn_acl_sec"
	previous_ipv6="$(uci -q get oum.main.passwall_policy_previous_ipv6 || true)"
	if [ -n "$previous_ipv6" ]; then
		uci -q set "passwall.@global_forwarding[0].ipv6_tproxy=$previous_ipv6"
		uci -q delete oum.main.passwall_policy_previous_ipv6
	fi
fi
uci commit passwall
uci commit oum

/etc/init.d/dnsmasq reload >/dev/null 2>&1 || /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true

# Updating an intentionally disabled PassWall instance does not require Xray
# readiness. Persist the cleaned policy and keep the service stopped.
if [ "$(uci -q get passwall.@global[0].enabled || echo 0)" != 1 ]; then
	/etc/init.d/passwall stop >/dev/null 2>&1 || true
	rm -f "$PASSWALL_BACKUP" "$DHCP_BACKUP" "$OUM_BACKUP"
	exit 0
fi

if /etc/init.d/passwall restart >"$PASSWALL_LOG" 2>&1; then
	attempt=0
	while [ "$attempt" -lt 45 ]; do
		if pidof xray >/dev/null 2>&1 && nft list table inet passwall >/dev/null 2>&1 &&
			ps w | grep -q '[d]nsmasq_default'; then
			rm -f "$PASSWALL_BACKUP" "$DHCP_BACKUP" "$OUM_BACKUP"
			exit 0
		fi
		attempt=$((attempt + 1))
		sleep 1
	done
fi

cp "$PASSWALL_BACKUP" /etc/config/passwall
cp "$DHCP_BACKUP" /etc/config/dhcp
cp "$OUM_BACKUP" /etc/config/oum
chmod 600 /etc/config/passwall /etc/config/dhcp /etc/config/oum
/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
/etc/init.d/passwall restart >>"$PASSWALL_LOG" 2>&1 || true
rm -f "$PASSWALL_BACKUP" "$DHCP_BACKUP" "$OUM_BACKUP"
exit 1
