#!/bin/sh

set -eu

INIT="${OUM_DROPBEAR_INIT:-/etc/init.d/dropbear}"
MARK='# OUM: permit an explicitly empty system password'
[ -f "$INIT" ] || exit 0
grep -Fq "$MARK" "$INIT" && exit 0
grep -Fq '[ "${PasswordAuth}" -eq 0 ] && procd_append_param command -s' "$INIT" || {
	echo "OUM: unsupported Dropbear init script" >&2
	exit 1
}

if [ "$INIT" = /etc/init.d/dropbear ]; then
	mkdir -p /etc/oum/compat
	cp "$INIT" /etc/oum/compat/dropbear.init.before-empty-password
fi

TMP="${INIT}.oum.$$"
while IFS= read -r line; do
	printf '%s\n' "$line"
	case "$line" in
		*'[ "${PasswordAuth}" -eq 0 ] && procd_append_param command -s'*)
			cat <<'EOF'
	[ -z "$(sed -n 's/^root:\([^:]*\):.*/\1/p' /etc/shadow)" ] && procd_append_param command -B # OUM: permit an explicitly empty system password
EOF
			;;
	esac
done < "$INIT" > "$TMP"
chmod --reference="$INIT" "$TMP" 2>/dev/null || chmod 755 "$TMP"
sh -n "$TMP"
mv "$TMP" "$INIT"
