#!/bin/sh

set -eu

setup_complete="$(uci -q get oum.main.setup_complete || echo 0)"

# OUM uses the stock OpenWrt root account for LuCI and SSH. Remove the legacy
# OUM login and keep root tied to the system password. A blank
# root password is intentionally supported for trusted LAN-only installations.
root_login=''
for section in $(uci -q show rpcd | sed -n "s/^rpcd\.\([^.=]*\)=login$/\1/p"); do
	case "$(uci -q get "rpcd.${section}.username" || true)" in
		root) root_login="$section" ;;
		admin) uci -q delete "rpcd.${section}" ;;
	esac
done
[ -n "$root_login" ] || root_login="$(uci -q add rpcd login)"
uci -q set "rpcd.${root_login}.username=root"
uci -q set "rpcd.${root_login}.password=\$p\$root"
uci -q delete "rpcd.${root_login}.read"
uci -q add_list "rpcd.${root_login}.read=*"
uci -q delete "rpcd.${root_login}.write"
uci -q add_list "rpcd.${root_login}.write=*"

for section in $(uci -q show dropbear | sed -n "s/^dropbear\.\([^.=]*\)=dropbear$/\1/p"); do
	uci -q set "dropbear.${section}.PasswordAuth=on"
	uci -q set "dropbear.${section}.RootPasswordAuth=on"
done

uci commit rpcd
uci commit dropbear
/usr/libexec/oum-dropbear-blank-password
/etc/init.d/rpcd restart
/etc/init.d/dropbear restart
[ "$setup_complete" = "1" ] && exit 0

for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	uci -q set "wireless.${radio}.country=US"
done

for iface in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
	[ "$(uci -q get "wireless.${iface}.mode")" = "ap" ] || continue
	uci -q set "wireless.${iface}.network=lan"
	uci -q set "wireless.${iface}.ssid=FirstRun"
	uci -q set "wireless.${iface}.encryption=sae-mixed"
	uci -q set "wireless.${iface}.key=admin123"
	uci -q set "wireless.${iface}.disabled=0"
done

# A fresh OUM setup uses 192.168.5.0/24 to avoid the common conflict with an
# upstream factory router on 192.168.1.0/24.
uci -q set network.lan.ipaddr='192.168.5.1'
uci -q set network.lan.netmask='255.255.255.0'

uci commit wireless
uci commit network
(sleep 2; /etc/init.d/network reload; wifi reload) >/tmp/oum-firstboot-network.log 2>&1 &
