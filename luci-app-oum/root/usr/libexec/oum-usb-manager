#!/bin/sh

set -eu
umask 077

ACTION="${1:-status}"
MOUNT_ROOT=/mnt/oum
FSTAB_SECTION=oum_usb
STORAGE_PACKAGES='block-mount kmod-usb-storage kmod-usb-storage-uas kmod-scsi-core kmod-fs-ext4 e2fsprogs parted'
SMB_PACKAGES='ksmbd-server'
SMB_SHARE_SECTION=oum_share
SMB_SHARE_NAME=OUM
ARIA2_PACKAGES='aria2 ariang'
ARIA2_SECTION=main
ARIA2_SECRET_FILE=/etc/oum/usb/aria2-secret
DLNA_PACKAGES='minidlna'
DLNA_SECTION=config
SORTER_PACKAGES='python3-light python3-codecs python3-openssl python3-urllib'
SORTER_CONFIG=/etc/oum/media-organizer.conf
SORTER_KEY=/etc/oum/tmdb_api_key
SORTER_COMMAND=/usr/libexec/oum-media-organizer-run
SORTER_CRON="*/5 * * * * $SORTER_COMMAND"

clean_value() {
	printf '%s' "${1:-}" | tr '\n\r\t' '   '
}

emit() {
	printf '%s=%s\n' "$1" "$(clean_value "${2:-}")"
}

storage_attached() {
	for class in /sys/bus/usb/devices/*:*/bInterfaceClass; do
		[ -f "$class" ] || continue
		[ "$(cat "$class" 2>/dev/null || true)" = 08 ] && return 0
	done
	return 1
}

usb_disk() {
	for path in /sys/class/block/sd[a-z]; do
		[ -e "$path" ] || continue
		target="$(readlink -f "$path/device" 2>/dev/null || true)"
		case "$target" in */usb*/*) printf '/dev/%s\n' "${path##*/}"; return 0 ;; esac
	done
	return 1
}

disk_partition() {
	disk="${1:-}"
	name="${disk##*/}"
	for path in "/sys/class/block/$name"[0-9]*; do
		[ -e "$path" ] || continue
		printf '/dev/%s\n' "${path##*/}"
		return 0
	done
	return 1
}

block_value() {
	line="$1"
	key="$2"
	printf '%s\n' "$line" | sed -n "s/.* $key=\"\([^\"]*\)\".*/\1/p"
}

mounted_at() {
	device="$1"
	awk -v device="$device" '$1 == device { print $2; exit }' /proc/mounts
}

packages_ready() {
	for package in $STORAGE_PACKAGES; do
		apk info -e "$package" >/dev/null 2>&1 || return 1
	done
}

service_enabled() {
	[ -x "/etc/init.d/$1" ] && "/etc/init.d/$1" enabled >/dev/null 2>&1
}

service_running() {
	[ -x "/etc/init.d/$1" ] && "/etc/init.d/$1" running >/dev/null 2>&1
}

managed_mountpoint() {
	target="$(uci -q get "fstab.$FSTAB_SECTION.target" 2>/dev/null || true)"
	[ -n "$target" ] || return 1
	awk -v target="$target" '$2 == target { found=1 } END { exit !found }' /proc/mounts || return 1
	printf '%s\n' "$target"
}

prepare_private_root() {
	root="$1/.oum"
	mkdir -p "$root"
	chown root:root "$root"
	chmod 0711 "$root"
}

sorter_enabled() {
	crontab -l 2>/dev/null | grep -Fqx "$SORTER_CRON"
}

sorter_value() {
	key="$1"
	[ -f "$SORTER_CONFIG" ] || return 0
	sed -n "s/^$key=//p" "$SORTER_CONFIG" | head -n 1
}

status() {
	disk="$(usb_disk 2>/dev/null || true)"
	partition=""
	[ -z "$disk" ] || partition="$(disk_partition "$disk" 2>/dev/null || true)"
	name="${disk##*/}"
	size=0
	model=""
	vendor=""
	if [ -n "$disk" ]; then
		sectors="$(cat "/sys/class/block/$name/size" 2>/dev/null || echo 0)"
		size="$((sectors * 512))"
		model="$(cat "/sys/class/block/$name/device/model" 2>/dev/null || true)"
		vendor="$(cat "/sys/class/block/$name/device/vendor" 2>/dev/null || true)"
	fi
	fs_type=""; uuid=""; label=""; mountpoint=""
	if [ -n "$partition" ]; then
		info="$(block info "$partition" 2>/dev/null || true)"
		fs_type="$(block_value "$info" TYPE)"
		uuid="$(block_value "$info" UUID)"
		label="$(block_value "$info" LABEL)"
		mountpoint="$(mounted_at "$partition")"
	fi
	emit host_present "$([ -d /sys/bus/usb/devices/usb1 ] && echo 1 || echo 0)"
	emit storage_attached "$(storage_attached && echo 1 || echo 0)"
	emit runtime_ready "$(packages_ready && echo 1 || echo 0)"
	emit disk "$disk"
	emit partition "$partition"
	emit size_bytes "$size"
	emit vendor "$vendor"
	emit model "$model"
	emit fs_type "$fs_type"
	emit uuid "$uuid"
	emit label "$label"
	emit mountpoint "$mountpoint"
	emit mounted "$([ -n "$mountpoint" ] && echo 1 || echo 0)"
	emit smb_installed "$(apk info -e ksmbd-server >/dev/null 2>&1 && echo 1 || echo 0)"
	emit smb_enabled "$(service_enabled ksmbd && echo 1 || echo 0)"
	emit smb_running "$(service_running ksmbd && echo 1 || echo 0)"
	emit smb_share "$([ -n "$mountpoint" ] && printf '%s/%s' "$mountpoint" "$SMB_SHARE_NAME" || true)"
	emit aria2_installed "$(apk info -e aria2 >/dev/null 2>&1 && apk info -e ariang >/dev/null 2>&1 && echo 1 || echo 0)"
	emit aria2_enabled "$(service_enabled aria2 && echo 1 || echo 0)"
	emit aria2_running "$(service_running aria2 && echo 1 || echo 0)"
	emit ariang_ready "$([ -f /www/ariang/index.html ] && echo 1 || echo 0)"
	emit aria2_dir "$([ -n "$mountpoint" ] && printf '%s/%s/Downloads' "$mountpoint" "$SMB_SHARE_NAME" || true)"
	emit aria2_secret_b64 "$([ -s "$ARIA2_SECRET_FILE" ] && base64 < "$ARIA2_SECRET_FILE" | tr '+/' '-_' | tr -d '=\n' || true)"
	emit dlna_installed "$(apk info -e minidlna >/dev/null 2>&1 && echo 1 || echo 0)"
	emit dlna_enabled "$(service_enabled minidlna && echo 1 || echo 0)"
	emit dlna_running "$(service_running minidlna && echo 1 || echo 0)"
	emit dlna_media_dir "$([ -n "$mountpoint" ] && printf '%s/%s/Media' "$mountpoint" "$SMB_SHARE_NAME" || true)"
	emit sorter_installed "$(apk info -e python3-light >/dev/null 2>&1 && [ -x /usr/libexec/oum-media-organizer ] && echo 1 || echo 0)"
	emit sorter_enabled "$(sorter_enabled && echo 1 || echo 0)"
	emit tmdb_key_set "$([ -s "$SORTER_KEY" ] && echo 1 || echo 0)"
	state_dir="$(sorter_value STATE_DIR)"
	if [ -n "$state_dir" ] && [ -f "$state_dir/status" ]; then
		emit sorter_last_run "$(sed -n 's/^last_run=//p' "$state_dir/status" | head -n 1)"
		emit sorter_result "$(sed -n 's/^result=//p' "$state_dir/status" | head -n 1)"
		emit sorter_message "$(sed -n 's/^message=//p' "$state_dir/status" | head -n 1)"
	else
		emit sorter_last_run ''
		emit sorter_result ''
		emit sorter_message ''
	fi
}

require_usb_disk() {
	requested="${1:-}"
	current="$(usb_disk 2>/dev/null || true)"
	[ -n "$current" ] || { echo 'USB disk not found' >&2; return 1; }
	[ "$requested" = "$current" ] || { echo 'USB disk changed; refresh status' >&2; return 1; }
	name="${current##*/}"
	target="$(readlink -f "/sys/class/block/$name/device" 2>/dev/null || true)"
	case "$target" in */usb*/*) ;; *) echo 'Refusing non-USB block device' >&2; return 1 ;; esac
	if awk -v disk="$current" '$2 == "/" && index($1, disk) == 1 { found=1 } END { exit !found }' /proc/mounts; then
		echo 'Refusing root device' >&2
		return 1
	fi
	printf '%s\n' "$current"
}

prepare() {
	apk -U add $STORAGE_PACKAGES
	modprobe usb-storage 2>/dev/null || true
	modprobe uas 2>/dev/null || true
	count=0
	while [ "$count" -lt 10 ]; do
		usb_disk >/dev/null 2>&1 && return 0
		count=$((count + 1))
		sleep 1
	done
	storage_attached && { echo 'Storage driver installed, reconnect the USB drive' >&2; return 2; }
	return 0
}

unmount_disk_partitions() {
	disk="$1"
	while read -r source target rest; do
		case "$source" in "$disk"|"$disk"[0-9]*) umount "$target" || return 1 ;; esac
	done < /proc/mounts
}

mount_partition() {
	partition="$1"
	info="$(block info "$partition" 2>/dev/null || true)"
	fs_type="$(block_value "$info" TYPE)"
	uuid="$(block_value "$info" UUID)"
	[ "$fs_type" = ext4 ] || { echo 'Only ext4 is supported in the first USB stage' >&2; return 1; }
	[ -n "$uuid" ] || { echo 'Filesystem UUID is missing' >&2; return 1; }
	short_uuid="$(printf '%s' "$uuid" | tr -cd 'A-Fa-f0-9' | cut -c1-8)"
	[ -n "$short_uuid" ] || short_uuid=storage
	target="$MOUNT_ROOT-$short_uuid"
	mkdir -p "$target"
	uci -q batch <<-EOF
		delete fstab.$FSTAB_SECTION
		set fstab.$FSTAB_SECTION='mount'
		set fstab.$FSTAB_SECTION.uuid='$uuid'
		set fstab.$FSTAB_SECTION.target='$target'
		set fstab.$FSTAB_SECTION.fstype='ext4'
		set fstab.$FSTAB_SECTION.options='rw,noatime'
		set fstab.$FSTAB_SECTION.enabled='1'
	EOF
	uci -q commit fstab
	mountpoint="$(mounted_at "$partition")"
	[ -z "$mountpoint" ] || [ "$mountpoint" = "$target" ] || { echo 'Partition is already mounted elsewhere' >&2; return 1; }
	[ -n "$mountpoint" ] || mount -t ext4 -o rw,noatime "$partition" "$target"
	[ "$(mounted_at "$partition")" = "$target" ] || return 1
	if service_enabled ksmbd; then
		share="$(uci -q get "ksmbd.$SMB_SHARE_SECTION.path" 2>/dev/null || true)"
		if [ "$share" = "$target/$SMB_SHARE_NAME" ]; then
			mkdir -p "$share"
			chown nobody:nogroup "$share"
			chmod 0775 "$share"
			/etc/init.d/ksmbd restart
		else
			/etc/init.d/ksmbd disable
		fi
	fi
	if service_enabled aria2; then
		download_dir="$(uci -q get "aria2.$ARIA2_SECTION.dir" 2>/dev/null || true)"
		config_dir="$(uci -q get "aria2.$ARIA2_SECTION.config_dir" 2>/dev/null || true)"
		if [ "$download_dir" = "$target/$SMB_SHARE_NAME/Downloads" ] && [ "$config_dir" = "$target/.oum/aria2" ]; then
			prepare_private_root "$target"
			mkdir -p "$download_dir" "$config_dir"
			chown aria2:nogroup "$download_dir"
			chmod 2775 "$download_dir"
			chown aria2:aria2 "$config_dir"
			chmod 0700 "$config_dir"
			/etc/init.d/aria2 restart
			chmod 0700 "$config_dir"
		else
			/etc/init.d/aria2 disable
		fi
	fi
	if service_enabled minidlna; then
		media_root="$(uci -q get "minidlna.$DLNA_SECTION.media_root" 2>/dev/null || true)"
		db_dir="$(uci -q get "minidlna.$DLNA_SECTION.db_dir" 2>/dev/null || true)"
		if [ "$media_root" = "$target/$SMB_SHARE_NAME/Media" ] && [ "$db_dir" = "$target/.oum/minidlna" ]; then
			prepare_private_root "$target"
			prepare_dlna_dirs "$media_root" "$db_dir"
			/etc/init.d/minidlna restart
		else
			/etc/init.d/minidlna disable
		fi
	fi
}

smb_enable() {
	target="$(managed_mountpoint)" || { echo 'Mount the managed USB storage before enabling SMB' >&2; return 1; }
	apk info -e ksmbd-server >/dev/null 2>&1 || apk -U add $SMB_PACKAGES
	mkdir -p /etc/oum/usb
	[ -e /etc/oum/usb/ksmbd-before-oum ] || cp -p /etc/config/ksmbd /etc/oum/usb/ksmbd-before-oum
	share="$target/$SMB_SHARE_NAME"
	mkdir -p "$share"
	chown nobody:nogroup "$share"
	chmod 0775 "$share"
	uci -q batch <<-EOF
		set ksmbd.@globals[0].interface='lan'
		set ksmbd.@globals[0].workgroup='WORKGROUP'
		set ksmbd.@globals[0].description='OUM storage'
		delete ksmbd.$SMB_SHARE_SECTION
		set ksmbd.$SMB_SHARE_SECTION='share'
		set ksmbd.$SMB_SHARE_SECTION.name='$SMB_SHARE_NAME'
		set ksmbd.$SMB_SHARE_SECTION.path='$share'
		set ksmbd.$SMB_SHARE_SECTION.read_only='no'
		set ksmbd.$SMB_SHARE_SECTION.writeable='yes'
		set ksmbd.$SMB_SHARE_SECTION.guest_ok='yes'
		set ksmbd.$SMB_SHARE_SECTION.browseable='yes'
		set ksmbd.$SMB_SHARE_SECTION.create_mask='0664'
		set ksmbd.$SMB_SHARE_SECTION.dir_mask='0775'
		delete ksmbd.$SMB_SHARE_SECTION.force_root
	EOF
	uci -q commit ksmbd
	/etc/init.d/ksmbd enable
	/etc/init.d/ksmbd restart
	service_running ksmbd
}

smb_disable() {
	[ -x /etc/init.d/ksmbd ] || return 0
	/etc/init.d/ksmbd stop
	/etc/init.d/ksmbd disable
}

aria2_enable() {
	target="$(managed_mountpoint)" || { echo 'Mount the managed USB storage before enabling aria2' >&2; return 1; }
	apk info -e aria2 >/dev/null 2>&1 && apk info -e ariang >/dev/null 2>&1 || apk -U add $ARIA2_PACKAGES
	mkdir -p /etc/oum/usb
	[ -e /etc/oum/usb/aria2-before-oum ] || cp -p /etc/config/aria2 /etc/oum/usb/aria2-before-oum
	if [ ! -s "$ARIA2_SECRET_FILE" ]; then
		hexdump -n 24 -e '24/1 "%02x"' /dev/urandom > "$ARIA2_SECRET_FILE"
		chmod 0600 "$ARIA2_SECRET_FILE"
	fi
	secret="$(cat "$ARIA2_SECRET_FILE")"
	download_dir="$target/$SMB_SHARE_NAME/Downloads"
	config_dir="$target/.oum/aria2"
	prepare_private_root "$target"
	mkdir -p "$download_dir" "$config_dir"
	chown aria2:nogroup "$download_dir"
	chmod 2775 "$download_dir"
	chown aria2:aria2 "$config_dir"
	chmod 0700 "$config_dir"
	uci -q batch <<-EOF
		set aria2.$ARIA2_SECTION='aria2'
		set aria2.$ARIA2_SECTION.enabled='1'
		set aria2.$ARIA2_SECTION.user='aria2'
		set aria2.$ARIA2_SECTION.dir='$download_dir'
		set aria2.$ARIA2_SECTION.config_dir='$config_dir'
		set aria2.$ARIA2_SECTION.rpc_auth_method='token'
		set aria2.$ARIA2_SECTION.rpc_secret='$secret'
		set aria2.$ARIA2_SECTION.rpc_listen_port='6800'
		set aria2.$ARIA2_SECTION.bt_enable_lpd='true'
		set aria2.$ARIA2_SECTION.enable_dht='true'
		set aria2.$ARIA2_SECTION.follow_torrent='true'
		set aria2.$ARIA2_SECTION.file_allocation='none'
		set aria2.$ARIA2_SECTION.save_session_interval='30'
	EOF
	uci -q commit aria2
	/etc/init.d/aria2 enable
	/etc/init.d/aria2 restart
	chmod 0700 "$config_dir"
	service_running aria2
}

aria2_disable() {
	[ -x /etc/init.d/aria2 ] || return 0
	/etc/init.d/aria2 stop
	/etc/init.d/aria2 disable
}

prepare_dlna_dirs() {
	media_root="$1"
	db_dir="$2"
	for directory in "$media_root" "$media_root/Movies" "$media_root/TV" "$media_root/Music" "$media_root/Pictures"; do
		mkdir -p "$directory"
		chown nobody:nogroup "$directory"
		chmod 2775 "$directory"
	done
	mkdir -p "$db_dir"
	chown minidlna:minidlna "$db_dir"
	chmod 0700 "$db_dir"
}

dlna_enable() {
	target="$(managed_mountpoint)" || { echo 'Mount the managed USB storage before enabling miniDLNA' >&2; return 1; }
	apk info -e minidlna >/dev/null 2>&1 || apk -U add $DLNA_PACKAGES
	mkdir -p /etc/oum/usb
	[ -e /etc/oum/usb/minidlna-before-oum ] || cp -p /etc/config/minidlna /etc/oum/usb/minidlna-before-oum
	media_root="$target/$SMB_SHARE_NAME/Media"
	db_dir="$target/.oum/minidlna"
	prepare_private_root "$target"
	prepare_dlna_dirs "$media_root" "$db_dir"
	uci -q batch <<-EOF
		set minidlna.$DLNA_SECTION='minidlna'
		set minidlna.$DLNA_SECTION.enabled='1'
		set minidlna.$DLNA_SECTION.user='minidlna'
		set minidlna.$DLNA_SECTION.port='8200'
		set minidlna.$DLNA_SECTION.interface='br-lan'
		set minidlna.$DLNA_SECTION.friendly_name='OUM Media'
		set minidlna.$DLNA_SECTION.db_dir='$db_dir'
		set minidlna.$DLNA_SECTION.media_root='$media_root'
		set minidlna.$DLNA_SECTION.inotify='1'
		set minidlna.$DLNA_SECTION.wide_links='0'
		set minidlna.$DLNA_SECTION.strict_dlna='0'
		set minidlna.$DLNA_SECTION.notify_interval='900'
		delete minidlna.$DLNA_SECTION.media_dir
		add_list minidlna.$DLNA_SECTION.media_dir='V,$media_root/Movies'
		add_list minidlna.$DLNA_SECTION.media_dir='V,$media_root/TV'
		add_list minidlna.$DLNA_SECTION.media_dir='A,$media_root/Music'
		add_list minidlna.$DLNA_SECTION.media_dir='P,$media_root/Pictures'
	EOF
	uci -q commit minidlna
	/etc/init.d/minidlna enable
	/etc/init.d/minidlna restart
	chmod 0700 "$db_dir"
	service_running minidlna
}

dlna_disable() {
	[ -x /etc/init.d/minidlna ] || return 0
	/etc/init.d/minidlna stop
	/etc/init.d/minidlna disable
}

sorter_enable() {
	target="$(managed_mountpoint)" || { echo 'Mount the managed USB storage before enabling the media organizer' >&2; return 1; }
	grep -Eq '^[A-Fa-f0-9]{32}$' "$SORTER_KEY" 2>/dev/null || { echo 'A valid TMDB API key is required' >&2; return 1; }
	[ -x /usr/libexec/oum-media-organizer ] && [ -x "$SORTER_COMMAND" ] || { echo 'Media organizer runtime is missing' >&2; return 1; }
	for package in $SORTER_PACKAGES; do
		apk info -e "$package" >/dev/null 2>&1 || { apk -U add $SORTER_PACKAGES; break; }
	done
	source_dir="$target/$SMB_SHARE_NAME/Downloads"
	media_dir="$target/$SMB_SHARE_NAME/Media"
	state_dir="$target/.oum/media-organizer"
	prepare_private_root "$target"
	mkdir -p "$source_dir" "$media_dir/Movies" "$media_dir/TV" "$state_dir"
	chown nobody:nogroup "$source_dir" "$media_dir" "$media_dir/Movies" "$media_dir/TV"
	chmod 2775 "$source_dir" "$media_dir" "$media_dir/Movies" "$media_dir/TV"
	chown root:root "$state_dir"
	chmod 0700 "$state_dir"
	mkdir -p /etc/oum
	cat > "$SORTER_CONFIG" <<-EOF
		SOURCE_DIR=$source_dir
		MOVIES_DIR=$media_dir/Movies
		TV_DIR=$media_dir/TV
		STATE_DIR=$state_dir
	EOF
	chmod 0600 "$SORTER_CONFIG"
	(crontab -l 2>/dev/null || true) | grep -Fvx "$SORTER_CRON" > /tmp/oum-sorter-cron || true
	printf '%s\n' "$SORTER_CRON" >> /tmp/oum-sorter-cron
	crontab /tmp/oum-sorter-cron
	rm -f /tmp/oum-sorter-cron
	/etc/init.d/cron restart
}

sorter_disable() {
	(crontab -l 2>/dev/null || true) | grep -Fvx "$SORTER_CRON" > /tmp/oum-sorter-cron || true
	crontab /tmp/oum-sorter-cron
	rm -f /tmp/oum-sorter-cron
	/etc/init.d/cron restart
}

sorter_run() {
	sorter_enabled || { echo 'Media organizer is disabled' >&2; return 1; }
	target="$(managed_mountpoint)" || { echo 'Mount the managed USB storage before sorting media' >&2; return 1; }
	[ "$(sorter_value SOURCE_DIR)" = "$target/$SMB_SHARE_NAME/Downloads" ] || { echo 'Media organizer belongs to another USB storage' >&2; return 1; }
	"$SORTER_COMMAND"
}

format_disk() {
	disk="$(require_usb_disk "${1:-}")"
	[ "${2:-}" = ERASE ] || { echo 'Format confirmation is missing' >&2; return 1; }
	# Formatting invalidates paths on the old filesystem. Leave USB services
	# off until the user explicitly enables them for the freshly formatted disk.
	sorter_disable
	dlna_disable
	aria2_disable
	smb_disable
	unmount_disk_partitions "$disk"
	parted -s "$disk" mklabel gpt
	parted -s "$disk" mkpart primary ext4 1MiB 100%
	partprobe "$disk" 2>/dev/null || true
	count=0
	partition=""
	while [ "$count" -lt 10 ]; do
		partition="$(disk_partition "$disk" 2>/dev/null || true)"
		[ -z "$partition" ] || break
		count=$((count + 1))
		sleep 1
	done
	[ -n "$partition" ] || { echo 'Partition did not appear after formatting' >&2; return 1; }
	# A media/download disk does not need the millions of inodes from the
	# generic ext4 profile. largefile keeps enough room for mixed NAS content
	# while avoiding minutes of needless writes on inexpensive flash drives.
	mkfs.ext4 -F -T largefile -m 0 -E lazy_itable_init=1,lazy_journal_init=1 -L OUM "$partition"
	block info "$partition" >/dev/null 2>&1 || true
	mount_partition "$partition"
}

mount_disk() {
	disk="$(require_usb_disk "${1:-}")"
	partition="$(disk_partition "$disk" 2>/dev/null || true)"
	[ -n "$partition" ] || { echo 'USB disk has no partition' >&2; return 1; }
	mount_partition "$partition"
}

unmount_managed() {
	partition="$(uci -q get "fstab.$FSTAB_SECTION.uuid" 2>/dev/null || true)"
	[ -n "$partition" ] || return 0
	target="$(uci -q get "fstab.$FSTAB_SECTION.target" 2>/dev/null || true)"
	service_running minidlna && /etc/init.d/minidlna stop
	service_running aria2 && /etc/init.d/aria2 stop
	service_running ksmbd && /etc/init.d/ksmbd stop
	[ -z "$target" ] || ! grep -qs " $target " /proc/mounts || umount "$target"
	uci -q set "fstab.$FSTAB_SECTION.enabled=0"
	uci -q commit fstab
}

case "$ACTION" in
	status) status ;;
	prepare) prepare ;;
	format) format_disk "${2:-}" "${3:-}" ;;
	mount) mount_disk "${2:-}" ;;
	unmount) unmount_managed ;;
	smb-enable) smb_enable ;;
	smb-disable) smb_disable ;;
	aria2-enable) aria2_enable ;;
	aria2-disable) aria2_disable ;;
	dlna-enable) dlna_enable ;;
	dlna-disable) dlna_disable ;;
	sorter-enable) sorter_enable ;;
	sorter-disable) sorter_disable ;;
	sorter-run) sorter_run ;;
	*) echo "usage: $0 {status|prepare|format DEVICE ERASE|mount DEVICE|unmount|smb-enable|smb-disable|aria2-enable|aria2-disable|dlna-enable|dlna-disable|sorter-enable|sorter-disable|sorter-run}" >&2; exit 2 ;;
esac
