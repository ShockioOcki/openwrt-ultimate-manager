#!/bin/sh

set -e

LOCK=/tmp/oum-traffic.lock
mkdir "$LOCK" 2>/dev/null || exit 0
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT INT TERM

CURRENT=/tmp/oum-traffic-current.tsv
HISTORY=/tmp/oum-traffic-history.tsv
TIMESTAMP=/tmp/oum-traffic-timestamp
RULES=/tmp/oum-traffic-rules.txt
NOW="$(date +%s)"
CUTOFF=$((NOW - 86400))

nft list table inet oum_traffic >/dev/null 2>&1 || nft add table inet oum_traffic
nft list chain inet oum_traffic account >/dev/null 2>&1 || nft 'add chain inet oum_traffic account { type filter hook forward priority -5; policy accept; }'
nft list chain inet oum_traffic account > "$RULES"

{
	awk '{ print $3 }' /tmp/dhcp.leases 2>/dev/null
	ip -4 neigh show dev br-lan 2>/dev/null | awk '$1 ~ /^[0-9]+\./ { print $1 }'
} | sort -u | while IFS= read -r ip; do
	printf '%s' "$ip" | awk -F. 'NF == 4 { for (i=1;i<=4;i++) if ($i !~ /^[0-9]+$/ || $i > 255) exit 1; exit 0 } NF != 4 { exit 1 }' || continue
	id="$(printf '%s' "$ip" | tr . _)"
	grep -Fq "oum_down_$id" "$RULES" || nft add rule inet oum_traffic account ip daddr "$ip" counter comment "oum_down_$id"
	grep -Fq "oum_up_$id" "$RULES" || nft add rule inet oum_traffic account ip saddr "$ip" counter comment "oum_up_$id"
done

nft list chain inet oum_traffic account | awk '
	/comment "oum_(down|up)_[0-9_]+"/ {
		direction = ($0 ~ /comment "oum_down_/) ? "down" : "up"
		ip = ""; bytes = 0
		for (i=1; i<=NF; i++) {
			if (($i == "daddr" || $i == "saddr") && $(i+1) ~ /^[0-9]+\./) ip=$(i+1)
			if ($i == "bytes" && $(i+1) ~ /^[0-9]+$/) bytes=$(i+1)
		}
		if (ip != "") {
			if (direction == "down") down[ip] += bytes; else up[ip] += bytes
			seen[ip] = 1
		}
	}
	END { for (ip in seen) printf "%s\t%.0f\t%.0f\n", ip, down[ip], up[ip] }
' > "$CURRENT.tmp"
mv "$CURRENT.tmp" "$CURRENT"

[ -f "$HISTORY" ] || : > "$HISTORY"
awk -v cutoff="$CUTOFF" '$1 >= cutoff' "$HISTORY" > "$HISTORY.tmp" || true
while IFS="$(printf '\t')" read -r ip down up; do
	[ -n "$ip" ] && printf '%s\t%s\t%s\t%s\n' "$NOW" "$ip" "$down" "$up" >> "$HISTORY.tmp"
done < "$CURRENT"
mv "$HISTORY.tmp" "$HISTORY"
printf '%s\n' "$NOW" > "$TIMESTAMP"
